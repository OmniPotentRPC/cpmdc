{
  "$schema": "https://context7.com/schema/context7.json",
  "projectTitle": "cpmdc",
  "description": "C ABI layer for embedding OpenCPMD in OmniPotentRPC tools.",
  "folders": [
    "docs/orgmode",
    "examples",
    "include",
    "python"
  ],
  "excludeFolders": [
    "docs/source",
    "docs/build",
    "docs/newsfragments",
    "newsfragments",
    "changelog.d",
    "benches",
    "benchmarks",
    "bench",
    "benchflow",
    "subprojects",
    "third_party",
    "tests",
    "scripts",
    "ci",
    ".github",
    "branding",
    ".pixi"
  ],
  "excludeFiles": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "rules": [
    "Inputs are Cap'n Proto CPMDParams from potentials-schema."
  ]
}
