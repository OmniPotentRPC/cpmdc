{
  "$schema": "https://context7.com/schema/context7.json",
  "projectTitle": "cpmdc",
  "description": "C ABI layer for embedding OpenCPMD in OmniPotentRPC tools.",
  "folders": [
    "docs",
    "examples",
    "include",
    "python",
    "tools"
  ],
  "excludeFolders": [
    "docs/source",
    "docs/newsfragments",
    "bench",
    "subprojects",
    "tests",
    "scripts",
    ".github",
    "branding"
  ],
  "excludeFiles": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "rules": [
    "Inputs are Cap'n Proto CPMDParams from potentials-schema."
  ]
}
