+  LOGICAL, SAVE :: cpmdc_have_orbitals = .FALSE.
+  COMPLEX(real_8), ALLOCATABLE, SAVE :: cpmdc_c0_store(:,:,:)
+  INTEGER, SAVE :: cpmdc_store_s1 = 0, cpmdc_store_s2 = 0, cpmdc_store_s3 = 0
   !public :: lseprof
 
 CONTAINS
 
+  SUBROUTINE cpmdc_set_warm_orbitals(flag)
+    LOGICAL, INTENT(IN) :: flag
+    cpmdc_warm_orbitals = flag
+  END SUBROUTINE cpmdc_set_warm_orbitals
+
+  SUBROUTINE cpmdc_set_need_forces(flag)
+    LOGICAL, INTENT(IN) :: flag
+    cpmdc_need_forces = flag
+  END SUBROUTINE cpmdc_set_need_forces
+
+  SUBROUTINE cpmdc_save_orbitals(c0)
+    COMPLEX(real_8), INTENT(IN) :: c0(:,:,:)
+    INTEGER :: ierr, s1, s2, s3
+    s1 = SIZE(c0, 1); s2 = SIZE(c0, 2); s3 = SIZE(c0, 3)
+    IF (ALLOCATED(cpmdc_c0_store)) THEN
+      IF (cpmdc_store_s1 /= s1 .OR. cpmdc_store_s2 /= s2 .OR. cpmdc_store_s3 /= s3) &
+          DEALLOCATE(cpmdc_c0_store)
+    END IF
+    IF (.NOT. ALLOCATED(cpmdc_c0_store)) THEN
+      ALLOCATE(cpmdc_c0_store(s1, s2, s3), STAT=ierr)
+      IF (ierr /= 0) RETURN
+      cpmdc_store_s1 = s1; cpmdc_store_s2 = s2; cpmdc_store_s3 = s3
+    END IF
+    cpmdc_c0_store = c0
+    cpmdc_have_orbitals = .TRUE.
+  END SUBROUTINE cpmdc_save_orbitals
+
+  SUBROUTINE cpmdc_restore_orbitals(c0)
+    COMPLEX(real_8), INTENT(INOUT) :: c0(:,:,:)
+    IF (.NOT. cpmdc_have_orbitals .OR. .NOT. ALLOCATED(cpmdc_c0_store)) RETURN
+    IF (SIZE(c0, 1) /= cpmdc_store_s1 .OR. SIZE(c0, 2) /= cpmdc_store_s2 .OR. &
+        SIZE(c0, 3) /= cpmdc_store_s3) RETURN
+    c0 = cpmdc_c0_store
+  END SUBROUTINE cpmdc_restore_orbitals
+
