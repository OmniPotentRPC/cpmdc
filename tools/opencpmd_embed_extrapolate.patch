+  ! ==================================================================
+  SUBROUTINE embed_break_history()
+    embed_xnow = 0
+    embed_xcount = 0
+    embed_xstate = 0
+  END SUBROUTINE embed_break_history
+
+  ! ==================================================================
+  INTEGER FUNCTION embed_extrapolation_used()
+    embed_extrapolation_used = embed_xused
+  END FUNCTION embed_extrapolation_used
+
+  ! ==================================================================
+  SUBROUTINE embed_extrapolate_orbitals(c0, cx)
+    ! ==--------------------------------------------------------------==
+    ! The BO-MD extrapolation of md_driver, with the calls of a host as
+    ! the steps: extrapwf adds the restored c0 to the ring and replaces it
+    ! by the ASPC or polynomial prediction that EXTRAPOLATE WFN asks for.
+    ! cx keeps that prediction for the copy after initrun.
+    COMPLEX(real_8), INTENT(INOUT) :: c0(:,:,:)
+    COMPLEX(real_8), ALLOCATABLE, INTENT(INOUT) :: cx(:,:,:)
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_extrapolate_orbitals'
+    REAL(real_8), ALLOCATABLE :: gam(:,:)
+    INTEGER :: ierr, m, n, nk, ng
+    embed_xused = 0
+    IF (.NOT. (embed_extrap_wfn .AND. embed_warm_orbitals .AND. &
+        embed_have_orbitals)) RETURN
+    IF (embed_xstate /= 1) THEN
+      CALL embed_break_history()
+      RETURN
+    ENDIF
+    m = cnti%mextra
+    n = crge%n
+    nk = nkpt%nkpnt
+    ng = nkpt%ngwk
+    IF (m < 1 .OR. cntl%bsymm .OR. SIZE(c0,1) /= ng .OR. &
+        SIZE(c0,2) < n .OR. SIZE(c0,3) < nk) RETURN
+    IF (ALLOCATED(embed_xhist)) THEN
+      IF (ANY(SHAPE(embed_xhist) /= (/ng, n, nk, m/))) DEALLOCATE(embed_xhist)
+    ENDIF
+    IF (.NOT. ALLOCATED(embed_xhist)) THEN
+      ALLOCATE(embed_xhist(ng, n, nk, m), STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'allocation problem',&
+           __LINE__,__FILE__)
+      embed_xnow = 0
+      embed_xcount = 0
+    ENDIF
+    ALLOCATE(cx(ng, n, nk), gam(n, 2*n), STAT=ierr)
+    IF(ierr/=0) CALL stopgm(procedureN,'allocation problem',&
+         __LINE__,__FILE__)
+    cx = c0(:, 1:n, 1:nk)
+    CALL extrapwf(0, cx, gam, embed_xhist, embed_xnow, embed_xcount, n, m)
+    c0(:, 1:n, 1:nk) = cx
+    embed_xstate = 2
+    embed_xused = embed_xcount
+    IF (embed_xcount < 2) DEALLOCATE(cx)
+  END SUBROUTINE embed_extrapolate_orbitals
+
 
