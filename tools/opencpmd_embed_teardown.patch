diff --git a/src/embed_teardown.mod.F90 b/src/embed_teardown.mod.F90
new file mode 100644
index 0000000..2f0ab5e
--- /dev/null
+++ b/src/embed_teardown.mod.F90
@@ -0,0 +1,1020 @@
+MODULE embed_teardown
+  ! Frees and resets what a CPMD setup leaves behind, so that one process
+  ! can set CPMD up again for another basis, or after a stopgm that
+  ! returned through cpmd_stopgm_hook. cpmd.x never calls it.
+  !
+  ! embed_teardown_state deallocates every PUBLIC module ALLOCATABLE,
+  ! frees the communicators set_cp_grp built, and moves embed_teardowns.
+  ! The routines of the wavefunction optimisation path that do work on
+  ! their first call only (phfac, setbasis, hf_init, addfftnset, the
+  ! density mixers, the symmetry setup, ...) then do it again, and free
+  ! the SAVE arrays they kept. The next setup starts as the first one in
+  ! the process did. The timer state that tistart set is kept: tistart
+  ! stops CPMD on a second call, so a host calls it once per process.
+  ! First-call state in response, TDDFT, path-integral and metadynamics
+  ! routines is not reset.
+  !
+  ! The deallocation list holds every ALLOCATABLE module variable, and
+  ! every ALLOCATABLE component of a module variable of derived type,
+  ! that a USE reaches, in the modules of SRC_MODULES except embed_ctrl,
+  ! error_handling, timer, time, rwfopt_utils (embed_reset_warm_orbitals
+  ! frees its copy of c0) and the CUDA device tables. dftd3c keeps its
+  ! arrays: the DFT-D3 library declares them PRIVATE.
+  USE atwf,                            ONLY: dmovrmix,&
+                                             natsave,&
+                                             tmovr
+  USE bicanonicalCpmd,                 ONLY: biCanonicalEnsembleDo
+  USE cp_xc_utils,                     ONLY: cp_xc
+  USE embed_ctrl,                      ONLY: embed_teardowns
+  USE ener,                            ONLY: tenergy_ok
+  USE hfxmod,                          ONLY: ipoolhfx
+  USE kinds,                           ONLY: real_8
+  USE mp_interface,                    ONLY: mp_comm_free,&
+                                             mp_comm_null,&
+                                             mp_comm_world
+  USE parac,                           ONLY: parai
+  USE rwfopt_utils,                    ONLY: embed_reset_warm_orbitals
+  USE scex_utils,                      ONLY: scex_ID_scaled
+  USE swap,                            ONLY: iswfirst
+  USE vdwcmod,                         ONLY: tdftd3noc
+
+  IMPLICIT NONE
+
+  PRIVATE
+
+  PUBLIC :: embed_teardown_state
+
+  ! startpa writes this into parai%allgrp before set_cp_grp builds it.
+  INTEGER, PARAMETER :: allgrp_unset = -123456789
+
+CONTAINS
+
+  ! ==================================================================
+  SUBROUTINE embed_teardown_state
+    ! ==--------------------------------------------------------------==
+    CALL embed_reset_warm_orbitals()
+    CALL free_cp_groups()
+    CALL free_module_arrays()
+    ! Module variables with an initial value that a run changes and no
+    ! setup routine writes again.
+    dmovrmix = HUGE(0.0_real_8)
+    natsave = HUGE(0)
+    tmovr = .FALSE.
+    tenergy_ok = .FALSE.
+    iswfirst = 0
+    ipoolhfx = HUGE(0)
+    scex_ID_scaled = 0
+    biCanonicalEnsembleDo = .FALSE.
+    tdftd3noc = .FALSE.
+    NULLIFY(cp_xc)
+    embed_teardowns = embed_teardowns + 1
+    ! ==--------------------------------------------------------------==
+  END SUBROUTINE embed_teardown_state
+  ! ==================================================================
+  SUBROUTINE free_cp_groups
+    ! ==--------------------------------------------------------------==
+    ! mp_cart builds allgrp and cp_inter_grp from mp_comm_world on every
+    ! setup. A setup that stopped before set_cp_grp left them unset.
+    IF (cp_group_set(parai%allgrp)) CALL mp_comm_free(parai%allgrp)
+    IF (cp_group_set(parai%cp_inter_grp)) CALL mp_comm_free(parai%cp_inter_grp)
+    parai%allgrp = mp_comm_null
+    parai%cp_inter_grp = mp_comm_null
+    ! ==--------------------------------------------------------------==
+  END SUBROUTINE free_cp_groups
+  ! ==================================================================
+  LOGICAL FUNCTION cp_group_set(comm)
+    INTEGER, INTENT(in)                      :: comm
+
+    ! parai holds HUGE(0) until startpa runs.
+    cp_group_set = comm /= mp_comm_null .AND. comm /= mp_comm_world &
+         .AND. comm /= allgrp_unset .AND. comm /= HUGE(0)
+  END FUNCTION cp_group_set
+  ! ==================================================================
+  SUBROUTINE free_module_arrays
+    ! ==--------------------------------------------------------------==
+    BLOCK
+      USE system, ONLY: iatpe, iatpt, ipept, kpbeg, mapgp, nassel, nkpbl, &
+           parap, paraw
+      IF (ALLOCATED(nkpbl)) DEALLOCATE(nkpbl)
+      IF (ALLOCATED(kpbeg)) DEALLOCATE(kpbeg)
+      IF (ALLOCATED(parap%nrxpl)) DEALLOCATE(parap%nrxpl)
+      IF (ALLOCATED(parap%nrzpl)) DEALLOCATE(parap%nrzpl)
+      IF (ALLOCATED(parap%sparm)) DEALLOCATE(parap%sparm)
+      IF (ALLOCATED(parap%nst12)) DEALLOCATE(parap%nst12)
+      IF (ALLOCATED(parap%pgroup)) DEALLOCATE(parap%pgroup)
+      IF (ALLOCATED(parap%nlink)) DEALLOCATE(parap%nlink)
+      IF (ALLOCATED(paraw%nwa12)) DEALLOCATE(paraw%nwa12)
+      IF (ALLOCATED(mapgp)) DEALLOCATE(mapgp)
+      IF (ALLOCATED(ipept)) DEALLOCATE(ipept)
+      IF (ALLOCATED(iatpt)) DEALLOCATE(iatpt)
+      IF (ALLOCATED(iatpe)) DEALLOCATE(iatpe)
+      IF (ALLOCATED(nassel)) DEALLOCATE(nassel)
+    END BLOCK
+    BLOCK
+      USE atom, ONLY: gnl, rps, rv, rw, vr
+      IF (ALLOCATED(gnl)) DEALLOCATE(gnl)
+      IF (ALLOCATED(rps)) DEALLOCATE(rps)
+      IF (ALLOCATED(rw)) DEALLOCATE(rw)
+      IF (ALLOCATED(rv)) DEALLOCATE(rv)
+      IF (ALLOCATED(vr)) DEALLOCATE(vr)
+    END BLOCK
+    BLOCK
+      USE atwf, ONLY: atchg, atrg, atrg_epr, atwfr, atwfr_epr, cat, catom, &
+           catord, xsmat, xxmat, zsmat, zxmat
+      IF (ALLOCATED(cat)) DEALLOCATE(cat)
+      IF (ALLOCATED(xxmat)) DEALLOCATE(xxmat)
+      IF (ALLOCATED(xsmat)) DEALLOCATE(xsmat)
+      IF (ALLOCATED(catom)) DEALLOCATE(catom)
+      IF (ALLOCATED(zxmat)) DEALLOCATE(zxmat)
+      IF (ALLOCATED(zsmat)) DEALLOCATE(zsmat)
+      IF (ALLOCATED(atrg)) DEALLOCATE(atrg)
+      IF (ALLOCATED(atwfr)) DEALLOCATE(atwfr)
+      IF (ALLOCATED(atchg)) DEALLOCATE(atchg)
+      IF (ALLOCATED(atrg_epr)) DEALLOCATE(atrg_epr)
+      IF (ALLOCATED(atwfr_epr)) DEALLOCATE(atwfr_epr)
+      IF (ALLOCATED(catord)) DEALLOCATE(catord)
+    END BLOCK
+    BLOCK
+      USE aavan, ONLY: indv
+      IF (ALLOCATED(indv)) DEALLOCATE(indv)
+    END BLOCK
+    BLOCK
+      USE coor, ONLY: fion, lvelini, tau0, taup, velp
+      IF (ALLOCATED(tau0)) DEALLOCATE(tau0)
+      IF (ALLOCATED(taup)) DEALLOCATE(taup)
+      IF (ALLOCATED(fion)) DEALLOCATE(fion)
+      IF (ALLOCATED(velp)) DEALLOCATE(velp)
+      IF (ALLOCATED(lvelini)) DEALLOCATE(lvelini)
+    END BLOCK
+    BLOCK
+      USE cotr, ONLY: anorm, askel, boad, cnpar, cnsval, cnsval_dest, csigm, &
+           dtm, fc, fcstr, fv, grate, gsrate, hess, kshove, lskcor, lskptr, &
+           mm_askel, ntcnst, ntrest, pmall, pxpar, resc, resfdiff, resfor, &
+           resm, respar, respos, resv, resval, resval_dest, rskel, rsmass, &
+           xlagr, ylagr
+      IF (ALLOCATED(boad)) DEALLOCATE(boad)
+      IF (ALLOCATED(lskcor)) DEALLOCATE(lskcor)
+      IF (ALLOCATED(ntcnst)) DEALLOCATE(ntcnst)
+      IF (ALLOCATED(lskptr)) DEALLOCATE(lskptr)
+      IF (ALLOCATED(mm_askel)) DEALLOCATE(mm_askel)
+      IF (ALLOCATED(hess)) DEALLOCATE(hess)
+      IF (ALLOCATED(dtm)) DEALLOCATE(dtm)
+      IF (ALLOCATED(pmall)) DEALLOCATE(pmall)
+      IF (ALLOCATED(kshove)) DEALLOCATE(kshove)
+      IF (ALLOCATED(cnsval)) DEALLOCATE(cnsval)
+      IF (ALLOCATED(cnpar)) DEALLOCATE(cnpar)
+      IF (ALLOCATED(anorm)) DEALLOCATE(anorm)
+      IF (ALLOCATED(askel)) DEALLOCATE(askel)
+      IF (ALLOCATED(grate)) DEALLOCATE(grate)
+      IF (ALLOCATED(cnsval_dest)) DEALLOCATE(cnsval_dest)
+      IF (ALLOCATED(fcstr)) DEALLOCATE(fcstr)
+      IF (ALLOCATED(fc)) DEALLOCATE(fc)
+      IF (ALLOCATED(fv)) DEALLOCATE(fv)
+      IF (ALLOCATED(csigm)) DEALLOCATE(csigm)
+      IF (ALLOCATED(xlagr)) DEALLOCATE(xlagr)
+      IF (ALLOCATED(ylagr)) DEALLOCATE(ylagr)
+      IF (ALLOCATED(ntrest)) DEALLOCATE(ntrest)
+      IF (ALLOCATED(resval)) DEALLOCATE(resval)
+      IF (ALLOCATED(resfor)) DEALLOCATE(resfor)
+      IF (ALLOCATED(gsrate)) DEALLOCATE(gsrate)
+      IF (ALLOCATED(resval_dest)) DEALLOCATE(resval_dest)
+      IF (ALLOCATED(rskel)) DEALLOCATE(rskel)
+      IF (ALLOCATED(resc)) DEALLOCATE(resc)
+      IF (ALLOCATED(resv)) DEALLOCATE(resv)
+      IF (ALLOCATED(respos)) DEALLOCATE(respos)
+      IF (ALLOCATED(resfdiff)) DEALLOCATE(resfdiff)
+      IF (ALLOCATED(resm)) DEALLOCATE(resm)
+      IF (ALLOCATED(rsmass)) DEALLOCATE(rsmass)
+      IF (ALLOCATED(respar)) DEALLOCATE(respar)
+      IF (ALLOCATED(pxpar)) DEALLOCATE(pxpar)
+    END BLOCK
+    BLOCK
+      USE cppt, ONLY: gk, gl, hg, hgpot, hipz, igl, indz, indzs, inyh, isptr, &
+           nzh, nzhs, qrad, rhops, scg, twnl, twnls, vps, ylmb
+      IF (ALLOCATED(nzh)) DEALLOCATE(nzh)
+      IF (ALLOCATED(nzhs)) DEALLOCATE(nzhs)
+      IF (ALLOCATED(indz)) DEALLOCATE(indz)
+      IF (ALLOCATED(indzs)) DEALLOCATE(indzs)
+      IF (ALLOCATED(inyh)) DEALLOCATE(inyh)
+      IF (ALLOCATED(igl)) DEALLOCATE(igl)
+      IF (ALLOCATED(isptr)) DEALLOCATE(isptr)
+      IF (ALLOCATED(hg)) DEALLOCATE(hg)
+      IF (ALLOCATED(gk)) DEALLOCATE(gk)
+      IF (ALLOCATED(gl)) DEALLOCATE(gl)
+      IF (ALLOCATED(vps)) DEALLOCATE(vps)
+      IF (ALLOCATED(rhops)) DEALLOCATE(rhops)
+      IF (ALLOCATED(twnl)) DEALLOCATE(twnl)
+      IF (ALLOCATED(qrad)) DEALLOCATE(qrad)
+      IF (ALLOCATED(twnls)) DEALLOCATE(twnls)
+      IF (ALLOCATED(ylmb)) DEALLOCATE(ylmb)
+      IF (ALLOCATED(hgpot)) DEALLOCATE(hgpot)
+      IF (ALLOCATED(hipz)) DEALLOCATE(hipz)
+      IF (ALLOCATED(scg)) DEALLOCATE(scg)
+    END BLOCK
+    BLOCK
+      USE cvan, ONLY: deeq, dvan, nelev, qq
+      IF (ALLOCATED(nelev)) DEALLOCATE(nelev)
+      IF (ALLOCATED(qq)) DEALLOCATE(qq)
+      IF (ALLOCATED(dvan)) DEALLOCATE(dvan)
+      IF (ALLOCATED(deeq)) DEALLOCATE(deeq)
+    END BLOCK
+    BLOCK
+      USE elct, ONLY: crge
+      IF (ALLOCATED(crge%f)) DEALLOCATE(crge%f)
+    END BLOCK
+    BLOCK
+      USE empf, ONLY: c, ibind, zan
+      IF (ALLOCATED(zan)) DEALLOCATE(zan)
+      IF (ALLOCATED(c)) DEALLOCATE(c)
+      IF (ALLOCATED(ibind)) DEALLOCATE(ibind)
+    END BLOCK
+    BLOCK
+      USE fft, ONLY: inzfp, inzhp, inzsp, lrxpl, lrxpool, mg, ms, msp, msqf, &
+           msqfpool, msqs, msqspool, mxy, mz, nzffp, nzfsp, sp5, sp8, sp9, &
+           spm, xf, yf
+      IF (ALLOCATED(mg)) DEALLOCATE(mg)
+      IF (ALLOCATED(ms)) DEALLOCATE(ms)
