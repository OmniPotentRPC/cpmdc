#!/usr/bin/env bash
# Meson ignores meson.format in the tree root when "meson format" is given a
# directory source such as ".". Prepend this script on PATH (pixi activation) so
# the project configuration is applied unless the caller already passes -c.
set -euo pipefail

root="${PIXI_PROJECT_ROOT:-}"
if [[ -z "${root}" ]]; then
  root="$(git -C "${PWD}" rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

strip_path="${root}/tools/bin"
clean_path="${PATH//${strip_path}:/}"
clean_path="${clean_path//:${strip_path}/}"
clean_path="${clean_path//${strip_path}/}"

real_meson="$(PATH="${clean_path}" command -v meson)"
if [[ -z "${real_meson}" ]]; then
  echo "meson: not found on PATH" >&2
  exit 127
fi

if [[ $# -ge 1 && $1 == format ]]; then
  config="${root}/meson.format"
  if [[ -f "${config}" ]]; then
    has_c=0
    for arg in "$@"; do
      case "${arg}" in
        -c|--configuration) has_c=1 ;;
      esac
    done
    if [[ "${has_c}" -eq 0 ]]; then
      set -- "$@" -c "${config}"
    fi
  fi
fi

exec "${real_meson}" "$@"
