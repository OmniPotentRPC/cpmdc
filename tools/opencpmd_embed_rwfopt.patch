   PUBLIC :: rwfopt
   PUBLIC :: give_scr_rwfopt
+  ! State for a program that calls rwfopt repeatedly in one process.
+  ! embed_need_forces defaults to .FALSE., embed_warm_orbitals defaults to
+  ! .FALSE., and embed_write_files defaults to .TRUE. Those defaults are
+  ! the cpmd.x behaviour, because cpmd.x never calls the setters.
+  !   embed_need_forces: compute the ionic forces and leave fion allocated
+  !     after a converged rwfopt. An unconverged call leaves fion zero.
+  !     The next rwfopt frees a surviving fion.
+  !   embed_warm_orbitals: start the next rwfopt from orbitals saved after
+  !     convwf was set. rinitwf leaves that c0 in place, and the first SCF
+  !     iteration builds the density from it. The first call has no stored
+  !     copy and still builds the guess. embed_have_orbitals lives in
+  !     rinitwf_driver. An unconverged pass keeps a partial copy only while
+  !     no converged copy exists, and rwfopt restores that copy when the
+  !     caller switches to PCG MINIMIZE.
+  !     embed_set_warm_orbitals(.FALSE.) frees the saved orbitals, as does
+  !     embed_reset_warm_orbitals. Call that after a caught stopgm or when
+  !     the system changes.
+  !   embed_write_files: lives in embed_ctrl and defaults to .TRUE.
+  !     .FALSE. skips the zhwwf RESTART writes and the geofile GEOMETRY
+  !     writes in rwfopt and in initrun. wrgeof still prints coordinates.
+  PUBLIC :: embed_set_warm_orbitals
+  PUBLIC :: embed_set_need_forces
+  PUBLIC :: embed_reset_warm_orbitals
+  PUBLIC :: embed_set_write_files
+  !   embed_select_orbital_slot(key): the stored c0 belongs to one key, a
+  !     calculation the caller names (an image of a band, a bead of a
+  !     ring). Selecting another key parks the converged c0 under the
+  !     current key and restores the one parked under the new key. A key
+  !     with nothing parked starts from the c0 already stored. Every slot
+  !     has the shape of the stored c0: embed_reset_warm_orbitals frees
+  !     them all, so a basis change cannot restore one of another shape.
+  !     cpmd.x never calls it, and a caller that never selects a key keeps
+  !     one stored c0.
+  PUBLIC :: embed_select_orbital_slot
+  PUBLIC :: embed_orbital_slot_count
+  !   embed_choose_warm_start(geo, rmax, dist, source): geo is the
+  !     geometry of the call about to run, in whatever flat layout and unit
+  !     the caller keeps (cpmdc passes its Angstrom positions). The stored
+  !     c0 and every parked c0 carry the geometry they converged at. Of
+  !     those, the one at the smallest root-mean-square distance per atom
+  !     (3 entries of geo per atom) starts the SCF when that distance is
+  !     at most rmax: a parked c0 of another key is copied into the store,
+  !     and the donor keeps its own. Farther than rmax, the stored c0 is
+  !     dropped and rinitwf builds the guess, because orbitals of a distant
+  !     geometry cost more SCF steps than the guess. rmax < 0 keeps the
+  !     store as it is. source returns 0 when the store starts the SCF, 1
+  !     when another key's c0 does, -1 when the guess does because every
+  !     stored c0 lies beyond rmax, and -2 when nothing is stored; dist
+  !     returns the smallest distance, HUGE when nothing is stored.
+  PUBLIC :: embed_choose_warm_start
+  INTEGER, PARAMETER :: embed_key_kind = SELECTED_INT_KIND(18)
+  TYPE :: embed_orbital_slot
+    INTEGER(embed_key_kind) :: key = 0
+    LOGICAL :: used = .FALSE.
+    COMPLEX(real_8), ALLOCATABLE :: c0(:,:,:)
+    REAL(real_8), ALLOCATABLE :: geo(:)
+  END TYPE embed_orbital_slot
+  TYPE(embed_orbital_slot), ALLOCATABLE, SAVE :: embed_slots(:)
+  LOGICAL, SAVE :: embed_have_key = .FALSE.
+  INTEGER(embed_key_kind), SAVE :: embed_current_key = 0
+  LOGICAL, SAVE :: embed_warm_orbitals = .FALSE.
+  LOGICAL, SAVE :: embed_need_forces = .FALSE.
+  LOGICAL, SAVE :: embed_have_partial = .FALSE.
+  COMPLEX(real_8), ALLOCATABLE, SAVE :: embed_c0_store(:,:,:)
+  INTEGER, SAVE :: embed_store_s1 = 0, embed_store_s2 = 0, embed_store_s3 = 0
+  ! The geometry embed_c0_store converged at, and the geometry of the call
+  ! in progress, as embed_choose_warm_start received them.
+  REAL(real_8), ALLOCATABLE, SAVE :: embed_store_geo(:), embed_call_geo(:)
   !public :: lseprof
 
 CONTAINS
 
+  ! ==================================================================
+  SUBROUTINE embed_set_warm_orbitals(flag)
+    ! ==--------------------------------------------------------------==
+    LOGICAL, INTENT(IN) :: flag
+    IF (flag) THEN
+       embed_warm_orbitals=.TRUE.
+    ELSE
+       CALL embed_reset_warm_orbitals
+    ENDIF
+  END SUBROUTINE embed_set_warm_orbitals
+
+  ! ==================================================================
+  SUBROUTINE embed_set_need_forces(flag)
+    ! ==--------------------------------------------------------------==
+    LOGICAL, INTENT(IN) :: flag
+    embed_need_forces = flag
+  END SUBROUTINE embed_set_need_forces
+
+  ! ==================================================================
+  SUBROUTINE embed_set_write_files(flag)
+    ! ==--------------------------------------------------------------==
+    LOGICAL, INTENT(IN) :: flag
+    embed_write_files = flag
+  END SUBROUTINE embed_set_write_files
+
+  ! ==================================================================
+  SUBROUTINE embed_reset_warm_orbitals()
+    ! ==--------------------------------------------------------------==
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_reset_warm_orbitals'
+    INTEGER :: ierr
+
+    embed_warm_orbitals = .FALSE.
+    embed_have_orbitals = .FALSE.
+    embed_have_partial = .FALSE.
+    IF (ALLOCATED(embed_c0_store)) THEN
+      DEALLOCATE(embed_c0_store,STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+           __LINE__,__FILE__)
+    ENDIF
+    embed_store_s1 = 0
+    embed_store_s2 = 0
+    embed_store_s3 = 0
+    IF (ALLOCATED(embed_store_geo)) DEALLOCATE(embed_store_geo)
+    IF (ALLOCATED(embed_call_geo)) DEALLOCATE(embed_call_geo)
+    ! Parked orbitals have the shape of the store they came from. The key
+    ! the caller selected stays selected.
+    IF (ALLOCATED(embed_slots)) THEN
+      DEALLOCATE(embed_slots,STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+           __LINE__,__FILE__)
+    ENDIF
+  END SUBROUTINE embed_reset_warm_orbitals
+
+  ! ==================================================================
+  INTEGER FUNCTION embed_orbital_slot_count()
+    ! ==--------------------------------------------------------------==
+    ! Keys with parked orbitals, the selected key excluded.
+    INTEGER :: i
+    embed_orbital_slot_count = 0
+    IF (.NOT. ALLOCATED(embed_slots)) RETURN
+    DO i = 1, SIZE(embed_slots)
+      IF (embed_slots(i)%used .AND. ALLOCATED(embed_slots(i)%c0)) &
+           embed_orbital_slot_count = embed_orbital_slot_count + 1
+    ENDDO
+  END FUNCTION embed_orbital_slot_count
+
+  ! ==================================================================
+  INTEGER FUNCTION embed_slot_index(key, create)
+    ! ==--------------------------------------------------------------==
+    ! Index of key in embed_slots, 0 when absent and create is false.
+    INTEGER(embed_key_kind), INTENT(IN) :: key
+    LOGICAL, INTENT(IN) :: create
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_slot_index'
+    TYPE(embed_orbital_slot), ALLOCATABLE :: grown(:)
+    INTEGER :: i, n, ierr
+    embed_slot_index = 0
+    n = 0
+    IF (ALLOCATED(embed_slots)) n = SIZE(embed_slots)
+    DO i = 1, n
+      IF (embed_slots(i)%used .AND. embed_slots(i)%key == key) THEN
+        embed_slot_index = i
+        RETURN
+      ENDIF
+    ENDDO
+    IF (.NOT. create) RETURN
+    DO i = 1, n
+      IF (.NOT. embed_slots(i)%used) THEN
+        embed_slots(i)%used = .TRUE.
+        embed_slots(i)%key = key
+        embed_slot_index = i
+        RETURN
+      ENDIF
+    ENDDO
+    ALLOCATE(grown(MAX(8, 2*n)),STAT=ierr)
+    IF(ierr/=0) CALL stopgm(procedureN,'allocation problem',&
+         __LINE__,__FILE__)
+    DO i = 1, n
+      grown(i)%used = embed_slots(i)%used
+      grown(i)%key = embed_slots(i)%key
+      IF (ALLOCATED(embed_slots(i)%c0)) &
+           CALL MOVE_ALLOC(embed_slots(i)%c0, grown(i)%c0)
+      IF (ALLOCATED(embed_slots(i)%geo)) &
+           CALL MOVE_ALLOC(embed_slots(i)%geo, grown(i)%geo)
+    ENDDO
+    CALL MOVE_ALLOC(grown, embed_slots)
+    embed_slots(n+1)%used = .TRUE.
+    embed_slots(n+1)%key = key
+    embed_slot_index = n + 1
+  END FUNCTION embed_slot_index
+
+  ! ==================================================================
+  SUBROUTINE embed_select_orbital_slot(key)
+    ! ==--------------------------------------------------------------==
+    INTEGER(embed_key_kind), INTENT(IN) :: key
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_select_orbital_slot'
+    INTEGER :: i, ierr
+    IF (embed_have_key .AND. key == embed_current_key) RETURN
+    ! Park the converged c0 of the key being left. A partial copy is not
+    ! a result and stays with the store.
+    IF (embed_have_key .AND. embed_have_orbitals .AND. &
+        ALLOCATED(embed_c0_store)) THEN
+      i = embed_slot_index(embed_current_key, .TRUE.)
+      IF (ALLOCATED(embed_slots(i)%c0)) THEN
+        DEALLOCATE(embed_slots(i)%c0,STAT=ierr)
+        IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+             __LINE__,__FILE__)
+      ENDIF
+      ALLOCATE(embed_slots(i)%c0(embed_store_s1, embed_store_s2, &
+           embed_store_s3),STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'allocation problem',&
+           __LINE__,__FILE__)
+      embed_slots(i)%c0 = embed_c0_store
+      IF (ALLOCATED(embed_slots(i)%geo)) DEALLOCATE(embed_slots(i)%geo)
+      IF (ALLOCATED(embed_store_geo)) embed_slots(i)%geo = embed_store_geo
+    ENDIF
+    embed_have_key = .TRUE.
+    embed_current_key = key
+    ! Restore what the new key parked. Without one, the store keeps the
+    ! orbitals of the key just left as this key's start.
+    i = embed_slot_index(key, .FALSE.)
+    IF (i == 0) RETURN
+    IF (.NOT. ALLOCATED(embed_slots(i)%c0)) RETURN
+    IF (ALLOCATED(embed_c0_store)) THEN
+      DEALLOCATE(embed_c0_store,STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+           __LINE__,__FILE__)
+    ENDIF
+    CALL MOVE_ALLOC(embed_slots(i)%c0, embed_c0_store)
+    IF (ALLOCATED(embed_store_geo)) DEALLOCATE(embed_store_geo)
+    IF (ALLOCATED(embed_slots(i)%geo)) &
+         CALL MOVE_ALLOC(embed_slots(i)%geo, embed_store_geo)
+    embed_store_s1 = SIZE(embed_c0_store, 1)
+    embed_store_s2 = SIZE(embed_c0_store, 2)
+    embed_store_s3 = SIZE(embed_c0_store, 3)
+    embed_have_orbitals = .TRUE.
+    embed_have_partial = .FALSE.
+  END SUBROUTINE embed_select_orbital_slot
+
+  ! ==================================================================
+  SUBROUTINE embed_save_orbitals(c0)
+    ! ==--------------------------------------------------------------==
+    COMPLEX(real_8), INTENT(IN) :: c0(:,:,:)
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_save_orbitals'
+    INTEGER :: ierr, s1, s2, s3
+    s1 = SIZE(c0, 1); s2 = SIZE(c0, 2); s3 = SIZE(c0, 3)
+    IF (ALLOCATED(embed_c0_store)) THEN
+      IF (embed_store_s1 /= s1 .OR. embed_store_s2 /= s2 .OR. embed_store_s3 /= s3) THEN
+        DEALLOCATE(embed_c0_store,STAT=ierr)
+        IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+             __LINE__,__FILE__)
+      ENDIF
+    ENDIF
+    IF (.NOT. ALLOCATED(embed_c0_store)) THEN
+      ALLOCATE(embed_c0_store(s1, s2, s3), STAT=ierr)
+      IF (ierr /= 0) THEN
+        embed_have_orbitals = .FALSE.
+        CALL stopgm('embed_save_orbitals', 'allocation problem', &
+             __LINE__, __FILE__)
+        RETURN
+      END IF
+      embed_store_s1 = s1; embed_store_s2 = s2; embed_store_s3 = s3
+    END IF
+    embed_c0_store = c0
+    IF (ALLOCATED(embed_store_geo)) DEALLOCATE(embed_store_geo)
+    IF (ALLOCATED(embed_call_geo)) embed_store_geo = embed_call_geo
+    embed_have_orbitals = .TRUE.
+  END SUBROUTINE embed_save_orbitals
+
+  ! ==================================================================
+  SUBROUTINE embed_restore_orbitals(c0)
+    ! ==--------------------------------------------------------------==
+    COMPLEX(real_8), INTENT(INOUT) :: c0(:,:,:)
+    IF (.NOT. (embed_have_orbitals .OR. embed_have_partial) .OR. &
+        .NOT. ALLOCATED(embed_c0_store)) RETURN
+    IF (SIZE(c0, 1) /= embed_store_s1 .OR. SIZE(c0, 2) /= embed_store_s2 .OR. &
+        SIZE(c0, 3) /= embed_store_s3) THEN
+      ! The saved orbitals belong to another cutoff, cell or state count.
+      CALL stopgm('embed_restore_orbitals', &
+           'saved orbitals do not match c0; call embed_reset_warm_orbitals', &
+           __LINE__, __FILE__)
+      RETURN
+    END IF
+    c0 = embed_c0_store
+  END SUBROUTINE embed_restore_orbitals
+
+  ! ==================================================================
+  REAL(real_8) FUNCTION embed_geo_rmsd(a, b)
+    ! ==--------------------------------------------------------------==
+    ! Root-mean-square distance per atom of two flat geometries, 3 entries
+    ! per atom; HUGE when they differ in length or are empty.
+    REAL(real_8), INTENT(IN) :: a(:), b(:)
+    embed_geo_rmsd = HUGE(1.0_real_8)
+    IF (SIZE(a) /= SIZE(b) .OR. SIZE(a) < 3) RETURN
+    embed_geo_rmsd = SQRT(3.0_real_8 * SUM((a - b)**2) / REAL(SIZE(a), real_8))
+  END FUNCTION embed_geo_rmsd
+
+  ! ==================================================================
+  SUBROUTINE embed_choose_warm_start(geo, rmax, dist, source)
+    ! ==--------------------------------------------------------------==
+    REAL(real_8), INTENT(IN) :: geo(:), rmax
+    REAL(real_8), INTENT(OUT) :: dist
+    INTEGER, INTENT(OUT) :: source
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_choose_warm_start'
+    INTEGER :: i, best, ierr
+    REAL(real_8) :: d
+    IF (ALLOCATED(embed_call_geo)) DEALLOCATE(embed_call_geo)
+    embed_call_geo = geo
+    dist = HUGE(1.0_real_8)
+    source = -2
+    best = -1
+    ! The store, which holds the selected key's own c0 when that key
+    ! parked one, else the c0 of the key last left.
+    IF (embed_have_orbitals .AND. ALLOCATED(embed_c0_store)) THEN
+      source = 0
+      best = 0
+      IF (ALLOCATED(embed_store_geo)) dist = embed_geo_rmsd(embed_store_geo, geo)
+    ENDIF
+    IF (ALLOCATED(embed_slots)) THEN
+      DO i = 1, SIZE(embed_slots)
+        IF (.NOT. embed_slots(i)%used) CYCLE
+        IF (.NOT. ALLOCATED(embed_slots(i)%c0)) CYCLE
+        IF (.NOT. ALLOCATED(embed_slots(i)%geo)) CYCLE
+        d = embed_geo_rmsd(embed_slots(i)%geo, geo)
+        IF (best < 0 .OR. d < dist) THEN
+          dist = d
+          best = i
+        ENDIF
+      ENDDO
+    ENDIF
+    IF (best < 0) RETURN
+    IF (rmax < 0.0_real_8) THEN
+      source = 0
+      IF (.NOT. embed_have_orbitals) source = -2
+      RETURN
+    ENDIF
+    IF (dist > rmax) THEN
+      embed_have_orbitals = .FALSE.
+      embed_have_partial = .FALSE.
+      source = -1
+      RETURN
+    ENDIF
+    source = 0
+    IF (best == 0) RETURN
+    IF (ALLOCATED(embed_c0_store)) THEN
+      DEALLOCATE(embed_c0_store,STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+           __LINE__,__FILE__)
+    ENDIF
+    embed_c0_store = embed_slots(best)%c0
+    embed_store_s1 = SIZE(embed_c0_store, 1)
+    embed_store_s2 = SIZE(embed_c0_store, 2)
+    embed_store_s3 = SIZE(embed_c0_store, 3)
+    embed_store_geo = embed_slots(best)%geo
+    embed_have_orbitals = .TRUE.
+    embed_have_partial = .FALSE.
+    source = 1
+  END SUBROUTINE embed_choose_warm_start
+
