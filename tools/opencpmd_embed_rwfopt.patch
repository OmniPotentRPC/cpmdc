@@ -106,10 +108,694 @@ MODULE rwfopt_utils
 
   PUBLIC :: rwfopt
   PUBLIC :: give_scr_rwfopt
+  ! State for a program that calls rwfopt repeatedly in one process.
+  ! embed_need_forces defaults to .FALSE., embed_warm_orbitals defaults to
+  ! .FALSE., and embed_write_files defaults to .TRUE. Those defaults are
+  ! the cpmd.x behaviour, because cpmd.x never calls the setters.
+  !   embed_need_forces: compute the ionic forces and leave fion allocated
+  !     after a converged rwfopt. An unconverged call leaves fion zero.
+  !     The next rwfopt frees a surviving fion.
+  !   embed_warm_orbitals: start the next rwfopt from orbitals saved after
+  !     convwf was set. rinitwf leaves that c0 in place, and the first SCF
+  !     iteration builds the density from it. The first call has no stored
+  !     copy and still builds the guess. embed_have_orbitals lives in
+  !     rinitwf_driver. An unconverged pass keeps a partial copy only while
+  !     no converged copy exists, and rwfopt restores that copy when the
+  !     caller switches to PCG MINIMIZE.
+  !     embed_set_warm_orbitals(.FALSE.) frees the saved orbitals, as does
+  !     embed_reset_warm_orbitals. Call that after a caught stopgm or when
+  !     the system changes.
+  !   embed_write_files: lives in embed_ctrl and defaults to .TRUE.
+  !     .FALSE. skips the zhwwf RESTART writes and the geofile GEOMETRY
+  !     writes in rwfopt and in initrun. wrgeof still prints coordinates.
+  PUBLIC :: embed_set_warm_orbitals
+  PUBLIC :: embed_set_need_forces
+  PUBLIC :: embed_reset_warm_orbitals
+  PUBLIC :: embed_set_write_files
+  !   embed_select_orbital_slot(key): the stored c0 belongs to one key, a
+  !     calculation the caller names (an image of a band, a bead of a
+  !     ring). Selecting another key parks the converged c0 under the
+  !     current key and restores the one parked under the new key. A key
+  !     with nothing parked starts from the c0 already stored. Every slot
+  !     has the shape of the stored c0: embed_reset_warm_orbitals frees
+  !     them all, so a basis change cannot restore one of another shape.
+  !     cpmd.x never calls it, and a caller that never selects a key keeps
+  !     one stored c0.
+  PUBLIC :: embed_select_orbital_slot
+  PUBLIC :: embed_orbital_slot_count
+  !   embed_choose_warm_start_metric_v2 receives species-ordered Cartesian positions,
+  !     the row-major cell, periodicity, and a geometry-distance callback.
+  !     Geometry and cell use Angstrom units. The stored
+  !     c0 and every parked c0 carry the geometry they converged at. Of
+  !     those, the one at the smallest root-mean-square distance per atom
+  !     (3 entries of geo per atom) starts the SCF when that distance is
+  !     at most rmax: a parked c0 of another key is copied into the store,
+  !     and the donor keeps its own. Farther than rmax, the stored c0 is
+  !     dropped and rinitwf builds the guess, because orbitals of a distant
+  !     geometry cost more SCF steps than the guess. rmax < 0 keeps the
+  !     store as it is. source returns 0 when the store starts the SCF, 1
+  !     when another key's c0 does, -1 when the guess does because every
+  !     stored c0 lies beyond rmax, and -2 when nothing is stored; dist
+  !     returns the smallest distance, HUGE when nothing is stored.
+  PUBLIC :: embed_choose_warm_start_metric_v2
+  INTEGER, PARAMETER :: embed_key_kind = SELECTED_INT_KIND(18)
+  TYPE :: embed_orbital_slot
+    INTEGER(embed_key_kind) :: key = 0
+    LOGICAL :: used = .FALSE.
+    COMPLEX(real_8), ALLOCATABLE :: c0(:,:,:)
+    REAL(real_8), ALLOCATABLE :: geo(:)
+  END TYPE embed_orbital_slot
+  PUBLIC :: embed_set_orbital_slot_limit
+  PUBLIC :: embed_parse_orbital_slot_limit
+  INTEGER, PARAMETER :: embed_limit_from_env = -1
+  INTEGER, PARAMETER :: embed_limit_unlimited = 0
+  INTEGER, PARAMETER :: embed_initial_slot_cap = 1
+  INTEGER, PARAMETER :: embed_slot_growth_factor = 2
+  INTEGER, PARAMETER :: embed_decimal_base = 10
+  INTEGER, PARAMETER :: embed_err_none = 0
+  INTEGER, PARAMETER :: embed_err_limit = 1
+  INTEGER, PARAMETER :: embed_err_dealloc = 2
+  INTEGER, PARAMETER :: embed_err_alloc = 3
+  TYPE(embed_orbital_slot), ALLOCATABLE, SAVE :: embed_slots(:)
+  INTEGER(embed_key_kind), ALLOCATABLE, SAVE :: embed_slot_stamps(:)
+  INTEGER(embed_key_kind), SAVE :: embed_park_seq = 0
+  INTEGER, SAVE :: embed_slot_limit_override = embed_limit_from_env
+  LOGICAL, SAVE :: embed_have_key = .FALSE.
+  INTEGER(embed_key_kind), SAVE :: embed_current_key = 0, embed_store_key = 0
+  LOGICAL, SAVE :: embed_warm_orbitals = .FALSE.
+  LOGICAL, SAVE :: embed_need_forces = .FALSE.
+  LOGICAL, SAVE :: embed_have_partial = .FALSE.
+  COMPLEX(real_8), ALLOCATABLE, SAVE :: embed_c0_store(:,:,:)
+  INTEGER, SAVE :: embed_store_s1 = 0, embed_store_s2 = 0, embed_store_s3 = 0
+  ! The geometry embed_c0_store converged at, and the geometry of the call
+  ! in progress, as embed_choose_warm_start_metric_v2 received them.
+  REAL(real_8), ALLOCATABLE, SAVE :: embed_store_geo(:), embed_call_geo(:)
+  REAL(real_8), SAVE :: embed_history_cell(9) = 0.0_real_8
+  LOGICAL, SAVE :: embed_history_set = .FALSE., embed_history_periodic = .FALSE.
   !public :: lseprof
 
 CONTAINS
 
+  ! ==================================================================
+  SUBROUTINE embed_set_warm_orbitals(flag)
+    ! ==--------------------------------------------------------------==
+    LOGICAL, INTENT(IN) :: flag
+    IF (flag) THEN
+       embed_warm_orbitals=.TRUE.
+    ELSE
+       CALL embed_reset_warm_orbitals
+    ENDIF
+  END SUBROUTINE embed_set_warm_orbitals
+
+  ! ==================================================================
+  SUBROUTINE embed_set_need_forces(flag)
+    ! ==--------------------------------------------------------------==
+    LOGICAL, INTENT(IN) :: flag
+    embed_need_forces = flag
+  END SUBROUTINE embed_set_need_forces
+
+  ! ==================================================================
+  SUBROUTINE embed_set_write_files(flag)
+    ! ==--------------------------------------------------------------==
+    LOGICAL, INTENT(IN) :: flag
+    embed_write_files = flag
+  END SUBROUTINE embed_set_write_files
+
+  ! ==================================================================
+  SUBROUTINE embed_reset_warm_orbitals()
+    ! ==--------------------------------------------------------------==
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_reset_warm_orbitals'
+    INTEGER :: ierr
+
+    embed_warm_orbitals = .FALSE.
+    embed_have_orbitals = .FALSE.
+    embed_have_partial = .FALSE.
+    embed_history_set = .FALSE.
+    IF (ALLOCATED(embed_c0_store)) THEN
+      DEALLOCATE(embed_c0_store,STAT=ierr)
+      IF(ierr/=0) THEN
+        CALL stopgm(procedureN,'deallocation problem',&
+             __LINE__,__FILE__)
+        RETURN
+      ENDIF
+    ENDIF
+    embed_store_s1 = 0
+    embed_store_s2 = 0
+    embed_store_s3 = 0
+    IF (ALLOCATED(embed_store_geo)) DEALLOCATE(embed_store_geo)
+    IF (ALLOCATED(embed_call_geo)) DEALLOCATE(embed_call_geo)
+    ! Parked orbitals have the shape of the store they came from. The key
+    ! the caller selected stays selected.
+    IF (ALLOCATED(embed_slots)) THEN
+      DEALLOCATE(embed_slots,STAT=ierr)
+      IF(ierr/=0) THEN
+        CALL stopgm(procedureN,'deallocation problem',&
+             __LINE__,__FILE__)
+        RETURN
+      ENDIF
+    ENDIF
+    IF (ALLOCATED(embed_slot_stamps)) THEN
+      DEALLOCATE(embed_slot_stamps,STAT=ierr)
+      IF(ierr/=0) THEN
+        CALL stopgm(procedureN,'deallocation problem',&
+             __LINE__,__FILE__)
+        RETURN
+      ENDIF
+    ENDIF
+    embed_park_seq = 0
+  END SUBROUTINE embed_reset_warm_orbitals
+
+  ! ==================================================================
+  INTEGER FUNCTION embed_count_parked_locked() RESULT(n)
+    ! ==--------------------------------------------------------------==
+    INTEGER :: i
+    n = 0
+    IF (.NOT. ALLOCATED(embed_slots)) RETURN
+    DO i = 1, SIZE(embed_slots)
+      IF (embed_slots(i)%used .AND. ALLOCATED(embed_slots(i)%c0)) &
+           n = n + 1
+    ENDDO
+  END FUNCTION embed_count_parked_locked
+
+  ! ==================================================================
+  INTEGER FUNCTION embed_orbital_slot_count()
+    ! ==--------------------------------------------------------------==
+    ! Keys with parked orbitals, the selected key excluded.
+    INTEGER :: counted
+    counted = 0
+    !$omp critical (embed_orbital_slots)
+    counted = embed_count_parked_locked()
+    !$omp end critical (embed_orbital_slots)
+    embed_orbital_slot_count = counted
+  END FUNCTION embed_orbital_slot_count
+
+  ! ==================================================================
+  SUBROUTINE embed_parse_orbital_slot_limit(limit, valid)
+    ! ==--------------------------------------------------------------==
+    ! Unset leaves parked storage unbounded (limit = embed_limit_unlimited,
+    ! valid = .TRUE.). Any set value must be a positive decimal integer;
+    ! zero, negative, empty, or non-integer values set valid = .FALSE.
+    INTEGER, INTENT(OUT) :: limit
+    LOGICAL, INTENT(OUT) :: valid
+    CHARACTER(LEN=:), ALLOCATABLE :: raw
+    INTEGER :: st, raw_len, ierr, first, last, pos, digit
+    limit = embed_limit_unlimited
+    valid = .TRUE.
+    CALL GET_ENVIRONMENT_VARIABLE('CPMDC_ORBITAL_SLOT_LIMIT', &
+         LENGTH=raw_len, STATUS=st)
+    IF (st > 0) RETURN
+    valid = .FALSE.
+    IF (st < 0 .OR. raw_len <= 0) RETURN
+    ALLOCATE(CHARACTER(LEN=raw_len) :: raw, STAT=ierr)
+    IF (ierr /= 0) RETURN
+    CALL GET_ENVIRONMENT_VARIABLE('CPMDC_ORBITAL_SLOT_LIMIT', &
+         VALUE=raw, STATUS=st)
+    IF (st /= 0) THEN
+      DEALLOCATE(raw, STAT=ierr)
+      RETURN
+    ENDIF
+    first = 1
+    DO WHILE (first <= raw_len)
+      IF (raw(first:first) /= ' ') EXIT
+      first = first + 1
+    ENDDO
+    last = raw_len
+    DO WHILE (last >= first)
+      IF (raw(last:last) /= ' ') EXIT
+      last = last - 1
+    ENDDO
+    IF (first > last) THEN
+      DEALLOCATE(raw, STAT=ierr)
+      RETURN
+    ENDIF
+    pos = first
+    IF (raw(pos:pos) == '+') pos = pos + 1
+    IF (pos > last) THEN
+      DEALLOCATE(raw, STAT=ierr)
+      RETURN
+    ENDIF
+    limit = 0
+    DO WHILE (pos <= last)
+      IF (raw(pos:pos) < '0' .OR. raw(pos:pos) > '9') THEN
+        limit = embed_limit_unlimited
+        DEALLOCATE(raw, STAT=ierr)
+        RETURN
+      ENDIF
+      digit = IACHAR(raw(pos:pos)) - IACHAR('0')
+      IF (limit > (HUGE(limit) - digit) / embed_decimal_base) THEN
+        limit = embed_limit_unlimited
+        DEALLOCATE(raw, STAT=ierr)
+        RETURN
+      ENDIF
+      limit = limit * embed_decimal_base + digit
+      pos = pos + 1
+    ENDDO
+    DEALLOCATE(raw, STAT=ierr)
+    IF (limit <= 0) THEN
+      limit = embed_limit_unlimited
+      RETURN
+    ENDIF
+    valid = .TRUE.
+  END SUBROUTINE embed_parse_orbital_slot_limit
+
+  ! ==================================================================
+  SUBROUTINE embed_effective_slot_limit(limit, valid)
+    ! ==--------------------------------------------------------------==
+    INTEGER, INTENT(OUT) :: limit
+    LOGICAL, INTENT(OUT) :: valid
+    IF (embed_slot_limit_override >= embed_limit_unlimited) THEN
+      limit = embed_slot_limit_override
+      valid = .TRUE.
+    ELSE
+      CALL embed_parse_orbital_slot_limit(limit, valid)
+    ENDIF
+  END SUBROUTINE embed_effective_slot_limit
+
+  ! ==================================================================
+  SUBROUTINE embed_clear_slot(idx, ierr)
+    ! ==--------------------------------------------------------------==
+    INTEGER, INTENT(IN) :: idx
+    INTEGER, INTENT(OUT) :: ierr
+    ierr = 0
+    IF (ALLOCATED(embed_slots(idx)%c0)) THEN
+      DEALLOCATE(embed_slots(idx)%c0, STAT=ierr)
+      IF (ierr /= 0) RETURN
+    ENDIF
+    IF (ALLOCATED(embed_slots(idx)%geo)) THEN
+      DEALLOCATE(embed_slots(idx)%geo, STAT=ierr)
+      IF (ierr /= 0) RETURN
+    ENDIF
+    embed_slots(idx)%used = .FALSE.
+    embed_slots(idx)%key = 0
+    IF (ALLOCATED(embed_slot_stamps)) THEN
+      IF (idx >= 1 .AND. idx <= SIZE(embed_slot_stamps)) &
+           embed_slot_stamps(idx) = 0_embed_key_kind
+    ENDIF
+  END SUBROUTINE embed_clear_slot
+
+  ! ==================================================================
+  INTEGER FUNCTION embed_find_slot_locked(key) RESULT(idx)
+    ! ==--------------------------------------------------------------==
+    INTEGER(embed_key_kind), INTENT(IN) :: key
+    INTEGER :: i
+    idx = 0
+    IF (.NOT. ALLOCATED(embed_slots)) RETURN
+    DO i = 1, SIZE(embed_slots)
+      IF (embed_slots(i)%used .AND. embed_slots(i)%key == key) THEN
+        idx = i
+        RETURN
+      ENDIF
+    ENDDO
+  END FUNCTION embed_find_slot_locked
+
+  ! ==================================================================
+  SUBROUTINE embed_evict_oldest_locked(protect_a, has_a, protect_b, has_b, &
+      evicted, ierr)
+    ! ==--------------------------------------------------------------==
+    ! Evict the oldest parked wavefunction (smallest stamp), excluding any
+    ! protected active or incoming key.
+    INTEGER(embed_key_kind), INTENT(IN) :: protect_a, protect_b
+    LOGICAL, INTENT(IN) :: has_a, has_b
+    LOGICAL, INTENT(OUT) :: evicted
+    INTEGER, INTENT(OUT) :: ierr
+    INTEGER :: i, victim
+    INTEGER(embed_key_kind) :: oldest
+    evicted = .FALSE.
+    ierr = 0
+    victim = 0
+    oldest = 0
+    IF (.NOT. ALLOCATED(embed_slots)) RETURN
+    DO i = 1, SIZE(embed_slots)
+      IF (.NOT. embed_slots(i)%used) CYCLE
+      IF (.NOT. ALLOCATED(embed_slots(i)%c0)) CYCLE
+      IF (has_a .AND. embed_slots(i)%key == protect_a) CYCLE
+      IF (has_b .AND. embed_slots(i)%key == protect_b) CYCLE
+      IF (victim == 0 .OR. embed_slot_stamps(i) < oldest) THEN
+        victim = i
+        oldest = embed_slot_stamps(i)
+      ENDIF
+    ENDDO
+    IF (victim == 0) RETURN
+    CALL embed_clear_slot(victim, ierr)
+    IF (ierr == 0) evicted = .TRUE.
+  END SUBROUTINE embed_evict_oldest_locked
+
+  ! ==================================================================
+  SUBROUTINE embed_acquire_free_slot_locked(idx, ierr)
+    ! ==--------------------------------------------------------------==
+    INTEGER, INTENT(OUT) :: idx, ierr
+    TYPE(embed_orbital_slot), ALLOCATABLE :: grown(:)
+    INTEGER(embed_key_kind), ALLOCATABLE :: grown_stamps(:)
+    INTEGER :: i, n, next_cap
+    idx = 0
+    ierr = 0
+    n = 0
+    IF (ALLOCATED(embed_slots)) n = SIZE(embed_slots)
+    DO i = 1, n
+      IF (.NOT. embed_slots(i)%used) THEN
+        idx = i
+        RETURN
+      ENDIF
+    ENDDO
+    next_cap = MAX(embed_initial_slot_cap, embed_slot_growth_factor * n)
+    ALLOCATE(grown(next_cap), STAT=ierr)
+    IF (ierr /= 0) RETURN
+    ALLOCATE(grown_stamps(next_cap), STAT=ierr)
+    IF (ierr /= 0) THEN
+      DEALLOCATE(grown)
+      RETURN
+    ENDIF
+    grown_stamps = 0_embed_key_kind
+    DO i = 1, n
+      grown(i)%used = embed_slots(i)%used
+      grown(i)%key = embed_slots(i)%key
+      IF (ALLOCATED(embed_slot_stamps)) THEN
+        IF (i <= SIZE(embed_slot_stamps)) grown_stamps(i) = embed_slot_stamps(i)
+      ENDIF
+      IF (ALLOCATED(embed_slots(i)%c0)) &
+           CALL MOVE_ALLOC(embed_slots(i)%c0, grown(i)%c0)
+      IF (ALLOCATED(embed_slots(i)%geo)) &
+           CALL MOVE_ALLOC(embed_slots(i)%geo, grown(i)%geo)
+    ENDDO
+    CALL MOVE_ALLOC(grown, embed_slots)
+    CALL MOVE_ALLOC(grown_stamps, embed_slot_stamps)
+    idx = n + 1
+  END SUBROUTINE embed_acquire_free_slot_locked
+
+  ! ==================================================================
+  SUBROUTINE embed_set_orbital_slot_limit(limit)
+    ! ==--------------------------------------------------------------==
+    ! Host override after calculator-rank consensus: embed_limit_from_env
+    ! reads CPMDC_ORBITAL_SLOT_LIMIT directly, embed_limit_unlimited leaves
+    ! parked slots unbounded, and a positive integer caps parked slots.
+    INTEGER, INTENT(IN) :: limit
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_set_orbital_slot_limit'
+    INTEGER :: ierr, err_kind
+    LOGICAL :: evicted
+    IF (limit < embed_limit_from_env) THEN
+      CALL stopgm(procedureN, &
+           'CPMDC_ORBITAL_SLOT_LIMIT must be a positive integer', &
+           __LINE__, __FILE__)
+      RETURN
+    ENDIF
+    err_kind = embed_err_none
+    !$omp critical (embed_orbital_slots)
+    embed_slot_limit_override = limit
+    IF (limit > embed_limit_unlimited) THEN
+      DO WHILE (embed_count_parked_locked() > limit)
+        CALL embed_evict_oldest_locked(embed_current_key, embed_have_key, &
+             0_embed_key_kind, .FALSE., evicted, ierr)
+        IF (ierr /= 0) THEN
+          err_kind = embed_err_dealloc
+          EXIT
+        ENDIF
+        IF (.NOT. evicted) EXIT
+      ENDDO
+    ENDIF
+    !$omp end critical (embed_orbital_slots)
+    IF (err_kind /= embed_err_none) THEN
+      CALL stopgm(procedureN, 'deallocation problem', &
+           __LINE__, __FILE__)
+      RETURN
+    ENDIF
+  END SUBROUTINE embed_set_orbital_slot_limit
+
+  ! ==================================================================
+  SUBROUTINE embed_swap_orbital_slot_locked(key, do_park, err_kind)
+    ! ==--------------------------------------------------------------==
+    INTEGER(embed_key_kind), INTENT(IN) :: key
+    LOGICAL, INTENT(IN) :: do_park
+    INTEGER, INTENT(OUT) :: err_kind
+    COMPLEX(real_8), ALLOCATABLE :: next_c0(:,:,:)
+    REAL(real_8), ALLOCATABLE :: next_geo(:)
+    LOGICAL :: valid, has_next, evicted
+    INTEGER :: limit, idx, ierr
+    err_kind = embed_err_none
+    CALL embed_effective_slot_limit(limit, valid)
+    IF (.NOT. valid) THEN
+      err_kind = embed_err_limit
+      RETURN
+    ENDIF
+    ! Extract the newly selected key first so it is never a candidate for
+    ! eviction and its slot no longer counts against the parked limit.
+    has_next = .FALSE.
+    idx = embed_find_slot_locked(key)
+    IF (idx > 0) THEN
+      IF (ALLOCATED(embed_slots(idx)%c0)) THEN
+        CALL MOVE_ALLOC(embed_slots(idx)%c0, next_c0)
+        IF (ALLOCATED(embed_slots(idx)%geo)) &
+             CALL MOVE_ALLOC(embed_slots(idx)%geo, next_geo)
+        has_next = .TRUE.
+      ENDIF
+      CALL embed_clear_slot(idx, ierr)
+      IF (ierr /= 0) THEN
+        err_kind = embed_err_dealloc
+        RETURN
+      ENDIF
+    ENDIF
+    IF (do_park) THEN
+      idx = embed_find_slot_locked(embed_current_key)
+      IF (idx > 0) THEN
+        CALL embed_clear_slot(idx, ierr)
+        IF (ierr /= 0) THEN
+          err_kind = embed_err_dealloc
+          RETURN
+        ENDIF
+      ENDIF
+      IF (limit > embed_limit_unlimited) THEN
+        DO WHILE (embed_count_parked_locked() >= limit)
+          CALL embed_evict_oldest_locked(embed_current_key, .TRUE., &
+               key, .TRUE., evicted, ierr)
+          IF (ierr /= 0) THEN
+            err_kind = embed_err_dealloc
+            RETURN
+          ENDIF
+          IF (.NOT. evicted) EXIT
+        ENDDO
+      ENDIF
+      CALL embed_acquire_free_slot_locked(idx, ierr)
+      IF (ierr /= 0 .OR. idx == 0) THEN
+        err_kind = embed_err_alloc
+        RETURN
+      ENDIF
+      IF (has_next) THEN
+        CALL MOVE_ALLOC(embed_c0_store, embed_slots(idx)%c0)
+        IF (ALLOCATED(embed_store_geo)) &
+             CALL MOVE_ALLOC(embed_store_geo, embed_slots(idx)%geo)
+      ELSE
+        ALLOCATE(embed_slots(idx)%c0(embed_store_s1, embed_store_s2, &
+             embed_store_s3), STAT=ierr)
+        IF (ierr /= 0) THEN
+          err_kind = embed_err_alloc
+          RETURN
+        ENDIF
+        embed_slots(idx)%c0 = embed_c0_store
+        IF (ALLOCATED(embed_store_geo)) embed_slots(idx)%geo = embed_store_geo
+      ENDIF
+      embed_park_seq = embed_park_seq + 1_embed_key_kind
+      embed_slots(idx)%used = .TRUE.
+      embed_slots(idx)%key = embed_current_key
+      embed_slot_stamps(idx) = embed_park_seq
+    ELSE IF (limit > embed_limit_unlimited) THEN
+      DO WHILE (embed_count_parked_locked() > limit)
+        CALL embed_evict_oldest_locked(key, .TRUE., &
+             embed_current_key, embed_have_key, evicted, ierr)
+        IF (ierr /= 0) THEN
+          err_kind = embed_err_dealloc
+          RETURN
+        ENDIF
+        IF (.NOT. evicted) EXIT
+      ENDDO
+    ENDIF
+    embed_have_key = .TRUE.
+    embed_current_key = key
+    IF (.NOT. has_next) RETURN
+    IF (ALLOCATED(embed_c0_store)) THEN
+      DEALLOCATE(embed_c0_store, STAT=ierr)
+      IF (ierr /= 0) THEN
+        err_kind = embed_err_dealloc
+        RETURN
+      ENDIF
+    ENDIF
+    CALL MOVE_ALLOC(next_c0, embed_c0_store)
+    embed_store_key = key
+    IF (ALLOCATED(embed_store_geo)) DEALLOCATE(embed_store_geo)
+    IF (ALLOCATED(next_geo)) CALL MOVE_ALLOC(next_geo, embed_store_geo)
+    embed_store_s1 = SIZE(embed_c0_store, 1)
+    embed_store_s2 = SIZE(embed_c0_store, 2)
+    embed_store_s3 = SIZE(embed_c0_store, 3)
+    embed_have_orbitals = .TRUE.
+    embed_have_partial = .FALSE.
+  END SUBROUTINE embed_swap_orbital_slot_locked
+
+  ! ==================================================================
+  SUBROUTINE embed_select_orbital_slot(key)
+    ! ==--------------------------------------------------------------==
+    INTEGER(embed_key_kind), INTENT(IN) :: key
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_select_orbital_slot'
+    INTEGER :: i, ierr
+    IF (embed_have_key .AND. key == embed_current_key) RETURN
+    ! Park the converged c0 of the key being left. A partial copy is not
+    ! a result and stays with the store.
+    IF (embed_have_key .AND. embed_have_orbitals .AND. &
+        ALLOCATED(embed_c0_store)) THEN
+      i = 1
+    ELSE
+      i = 0
+    ENDIF
+    ierr = embed_err_none
+    !$omp critical (embed_orbital_slots)
+    CALL embed_swap_orbital_slot_locked(key, i /= 0, ierr)
+    !$omp end critical (embed_orbital_slots)
+    IF (ierr == embed_err_limit) THEN
+      CALL stopgm(procedureN, &
+           'CPMDC_ORBITAL_SLOT_LIMIT must be a positive integer', &
+           __LINE__, __FILE__)
+      RETURN
+    ELSE IF (ierr == embed_err_dealloc) THEN
+      CALL stopgm(procedureN, 'deallocation problem', &
+           __LINE__, __FILE__)
+      RETURN
+    ELSE IF (ierr /= embed_err_none) THEN
+      CALL stopgm(procedureN, 'allocation problem', &
+           __LINE__, __FILE__)
+      RETURN
+    ENDIF
+  END SUBROUTINE embed_select_orbital_slot
+
+  ! ==================================================================
+  SUBROUTINE embed_save_orbitals(c0)
+    ! ==--------------------------------------------------------------==
+    COMPLEX(real_8), INTENT(IN) :: c0(:,:,:)
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_save_orbitals'
+    INTEGER :: ierr, s1, s2, s3
+    s1 = SIZE(c0, 1); s2 = SIZE(c0, 2); s3 = SIZE(c0, 3)
+    IF (ALLOCATED(embed_c0_store)) THEN
+      IF (embed_store_s1 /= s1 .OR. embed_store_s2 /= s2 .OR. embed_store_s3 /= s3) THEN
+        DEALLOCATE(embed_c0_store,STAT=ierr)
+        IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+             __LINE__,__FILE__)
+      ENDIF
+    ENDIF
+    IF (.NOT. ALLOCATED(embed_c0_store)) THEN
+      ALLOCATE(embed_c0_store(s1, s2, s3), STAT=ierr)
+      IF (ierr /= 0) THEN
+        embed_have_orbitals = .FALSE.
+        CALL stopgm('embed_save_orbitals', 'allocation problem', &
+             __LINE__, __FILE__)
+        RETURN
+      END IF
+      embed_store_s1 = s1; embed_store_s2 = s2; embed_store_s3 = s3
+    END IF
+    embed_c0_store = c0
+    embed_store_key = embed_current_key
+    IF (ALLOCATED(embed_store_geo)) DEALLOCATE(embed_store_geo)
+    IF (ALLOCATED(embed_call_geo)) embed_store_geo = embed_call_geo
+    embed_have_orbitals = .TRUE.
+  END SUBROUTINE embed_save_orbitals
+
+  ! ==================================================================
+  SUBROUTINE embed_restore_orbitals(c0)
+    ! ==--------------------------------------------------------------==
+    COMPLEX(real_8), INTENT(INOUT) :: c0(:,:,:)
+    IF (.NOT. (embed_have_orbitals .OR. embed_have_partial) .OR. &
+        .NOT. ALLOCATED(embed_c0_store)) RETURN
+    IF (SIZE(c0, 1) /= embed_store_s1 .OR. SIZE(c0, 2) /= embed_store_s2 .OR. &
+        SIZE(c0, 3) /= embed_store_s3) THEN
+      ! The saved orbitals belong to another cutoff, cell or state count.
+      CALL stopgm('embed_restore_orbitals', &
+           'saved orbitals do not match c0; call embed_reset_warm_orbitals', &
+           __LINE__, __FILE__)
+      RETURN
+    END IF
+    c0 = embed_c0_store
+  END SUBROUTINE embed_restore_orbitals
+
+  ! ==================================================================
+  SUBROUTINE embed_choose_warm_start_metric_v2(geo, cell, periodic, rmax, dist, source, donor, distance)
+    ! ==--------------------------------------------------------------==
+    REAL(real_8), INTENT(IN) :: geo(:), cell(9), rmax
+    LOGICAL, INTENT(IN) :: periodic
+    INTERFACE
+      FUNCTION distance(a, b, box, use_periodic) RESULT(d)
+        IMPORT :: real_8
+        REAL(real_8), INTENT(IN) :: a(:), b(:), box(9)
+        LOGICAL, INTENT(IN) :: use_periodic
+        REAL(real_8) :: d
+      END FUNCTION distance
+    END INTERFACE
+    REAL(real_8), INTENT(OUT) :: dist
+    INTEGER, INTENT(OUT) :: source
+    INTEGER(embed_key_kind), INTENT(OUT) :: donor
+    CHARACTER(*), PARAMETER :: procedureN = 'embed_choose_warm_start_metric_v2'
+    INTEGER :: i, best, ierr
+    REAL(real_8) :: d
+    ! A plane-wave orbital history belongs to one cell and boundary model.
+    IF (embed_history_set) THEN
+      IF ((periodic .NEQV. embed_history_periodic) .OR. &
+          ANY(cell /= embed_history_cell)) CALL embed_reset_warm_orbitals()
+    ENDIF
+    embed_history_cell = cell
+    embed_history_periodic = periodic
+    embed_history_set = .TRUE.
+    IF (ALLOCATED(embed_call_geo)) DEALLOCATE(embed_call_geo)
+    embed_call_geo = geo
+    dist = HUGE(1.0_real_8)
+    source = -2
+    best = -1
+    donor = 0
+    ! The store, which holds the selected key's own c0 when that key
+    ! parked one, else the c0 of the key last left.
+    IF (embed_have_orbitals .AND. ALLOCATED(embed_c0_store)) THEN
+      source = 0
+      best = 0
+      IF (ALLOCATED(embed_store_geo)) dist = distance(embed_store_geo, geo, cell, periodic)
+    ENDIF
+    IF (ALLOCATED(embed_slots)) THEN
+      DO i = 1, SIZE(embed_slots)
+        IF (.NOT. embed_slots(i)%used) CYCLE
+        IF (.NOT. ALLOCATED(embed_slots(i)%c0)) CYCLE
+        IF (.NOT. ALLOCATED(embed_slots(i)%geo)) CYCLE
+        d = distance(embed_slots(i)%geo, geo, cell, periodic)
+        IF (best < 0 .OR. d < dist) THEN
+          dist = d
+          best = i
+        ENDIF
+      ENDDO
+    ENDIF
+    IF (best < 0) RETURN
+    donor = embed_store_key
+    IF (best > 0) donor = embed_slots(best)%key
+    IF (rmax < 0.0_real_8) THEN
+      source = 0
+      IF (.NOT. embed_have_orbitals) source = -2
+      RETURN
+    ENDIF
+    IF (dist > rmax) THEN
+      embed_have_orbitals = .FALSE.
+      embed_have_partial = .FALSE.
+      source = -1
+      RETURN
+    ENDIF
+    source = 0
+    IF (best == 0) RETURN
+    IF (ALLOCATED(embed_c0_store)) THEN
+      DEALLOCATE(embed_c0_store,STAT=ierr)
+      IF(ierr/=0) CALL stopgm(procedureN,'deallocation problem',&
+           __LINE__,__FILE__)
+    ENDIF
+    embed_c0_store = embed_slots(best)%c0
+    embed_store_key = embed_slots(best)%key
+    embed_store_s1 = SIZE(embed_c0_store, 1)
+    embed_store_s2 = SIZE(embed_c0_store, 2)
+    embed_store_s3 = SIZE(embed_c0_store, 3)
+    embed_store_geo = embed_slots(best)%geo
+    embed_have_orbitals = .TRUE.
+    embed_have_partial = .FALSE.
+    source = 1
+  END SUBROUTINE embed_choose_warm_start_metric_v2
+
