@@ -48,6 +48,18 @@
 
 CONTAINS
 
+  PURE FUNCTION scaled_pcg_step(force0,force1,alam) RESULT(step)
+    REAL(real_8), INTENT(IN) :: force0, force1, alam
+    REAL(real_8) :: step, scale, slope
+    ! Directional derivatives share the square of the orbital-gradient scale.
+    ! Normalizing both preserves the interpolated root at small residuals.
+    scale=MAX(ABS(force0),ABS(force1))
+    step=alam
+    IF (scale.EQ.0._real_8) RETURN
+    slope=force1/scale-force0/scale
+    IF (slope.NE.0._real_8) step=-(force0/scale)*alam/slope
+  END FUNCTION scaled_pcg_step
+
