+  SUBROUTINE embed_get_charges(charges, n, valid, capacity)
+    REAL(real_8), INTENT(OUT) :: charges(*)
+    INTEGER, INTENT(OUT) :: n
+    LOGICAL, INTENT(OUT) :: valid
+    INTEGER, INTENT(IN) :: capacity
+    INTEGER :: i
+    n = embed_charge_count
+    valid = embed_charges_valid
+    IF (.NOT. valid) RETURN
+    IF (capacity.LT.n) THEN
+       valid = .FALSE.
+       RETURN
+    END IF
+    DO i = 1, n
+       charges(i) = embed_charges(i)
+    END DO
+  END SUBROUTINE embed_get_charges
+
+  ! Hirshfeld charges q = Z_v - n from atomc, in species order.
+  ! proppt stops on k points before atomc, so that path stays invalid.
+  ! A second density build rewrites chrg and the kinetic terms, which
+  ! are restored. cpmd.x never sets the request.
+  SUBROUTINE embed_collect_charges(c0)
+    COMPLEX(real_8)                          :: c0(:,:,:)
+
+    INTEGER                                  :: ierr, il_psi_1d, il_psi_2d, &
+                                                il_rhoe_1d, il_rhoe_2d, is, n
+    REAL(real_8)                             :: saved_ekin, saved_ekin_a, &
+                                                saved_ekin_2, saved_ekin_ab
+    REAL(real_8), ALLOCATABLE                :: achrg(:), rbuff(:), rhoe(:,:)
+    COMPLEX(real_8), ALLOCATABLE             :: psi(:,:)
+    TYPE(chrg_t)                             :: saved_chrg
+
+    embed_charges_valid = .FALSE.
+    embed_charge_count = 0
+    IF (.NOT. embed_charges_enabled) RETURN
+    IF (.NOT. ropt_mod%convwf) RETURN
+    IF (tkpts%tkpnt) RETURN
+    IF (cntl%bsymm) RETURN
+    n = ions1%nat
+    IF (n.LT.1) RETURN
+    DO is = 1, ions1%nsp
+       IF (atwf_mod%nshell(is).LT.1 .OR. &
+            atwf_mod%nshell(is).GT.m1shlx) RETURN
+    END DO
+    saved_chrg = chrg
+    saved_ekin = ener_com%ekin
+    saved_ekin_a = ener_c%ekin_a
+    saved_ekin_2 = ener_c%ekin_2
+    saved_ekin_ab = ener_c%ekin_ab
+    CALL rhoe_psi_size(il_rhoe_1d=il_rhoe_1d, il_rhoe_2d=il_rhoe_2d, &
+         il_psi_1d=il_psi_1d, il_psi_2d=il_psi_2d)
+    IF (il_rhoe_1d.LT.1 .OR. il_rhoe_2d.LT.1 .OR. &
+         il_psi_1d.LT.1 .OR. il_psi_2d.LT.1 .OR. fpar%nnr1.LT.1) THEN
+       RETURN
+    END IF
+    ALLOCATE(rhoe(il_rhoe_1d,il_rhoe_2d), psi(il_psi_1d,il_psi_2d), &
+         achrg(n), rbuff(fpar%nnr1), STAT=ierr)
+    IF (ierr.NE.0) RETURN
+    IF (pslo_com%tivan) CALL rnlsm(c0(:,1:crge%n,1), crge%n, 1, 1, .FALSE.)
+    CALL rhoofr(c0(:,:,1), rhoe, psi(:,1), crge%n)
+    CALL atomc(rhoe(:,1), rbuff, tau0, achrg)
+    chrg = saved_chrg
+    ener_com%ekin = saved_ekin
+    ener_c%ekin_a = saved_ekin_a
+    ener_c%ekin_2 = saved_ekin_2
+    ener_c%ekin_ab = saved_ekin_ab
+    IF (ALLOCATED(embed_charges)) THEN
+       IF (SIZE(embed_charges).NE.n) DEALLOCATE(embed_charges)
+    END IF
+    IF (.NOT. ALLOCATED(embed_charges)) THEN
+       ALLOCATE(embed_charges(n), STAT=ierr)
+       IF (ierr.NE.0) THEN
+          DEALLOCATE(rhoe, psi, achrg, rbuff)
+          RETURN
+       END IF
+    END IF
+    embed_charges(1:n) = achrg(1:n)
+    embed_charge_count = n
+    embed_charges_valid = .TRUE.
+    DEALLOCATE(rhoe, psi, achrg, rbuff)
+  END SUBROUTINE embed_collect_charges
+
