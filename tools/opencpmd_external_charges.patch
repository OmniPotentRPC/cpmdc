diff --git a/src/efld.mod.F90 b/src/efld.mod.F90
index ab764e6..8c7a265 100644
--- a/src/efld.mod.F90
+++ b/src/efld.mod.F90
@@ -7,6 +7,34 @@ MODULE efld
 
   REAL(real_8), POINTER :: extf(:)
 
+  ABSTRACT INTERFACE
+     SUBROUTINE cpmdc_external_force_interface(rhoe)
+       IMPORT :: real_8
+       REAL(real_8), INTENT(IN) :: rhoe(*)
+     END SUBROUTINE cpmdc_external_force_interface
+  END INTERFACE
+
+  PROCEDURE(cpmdc_external_force_interface), POINTER :: &
+       cpmdc_external_force_hook => NULL()
+
   ! ==================================================================
 
+CONTAINS
+
+  SUBROUTINE set_cpmdc_external_force_hook(hook)
+    PROCEDURE(cpmdc_external_force_interface), OPTIONAL :: hook
+    IF (PRESENT(hook)) THEN
+       cpmdc_external_force_hook => hook
+    ELSE
+       NULLIFY(cpmdc_external_force_hook)
+    END IF
+  END SUBROUTINE set_cpmdc_external_force_hook
+
+  SUBROUTINE run_cpmdc_external_force_hook(rhoe)
+    REAL(real_8), INTENT(IN) :: rhoe(*)
+    IF (ASSOCIATED(cpmdc_external_force_hook)) THEN
+       CALL cpmdc_external_force_hook(rhoe)
+    END IF
+  END SUBROUTINE run_cpmdc_external_force_hook
+
 END MODULE efld
