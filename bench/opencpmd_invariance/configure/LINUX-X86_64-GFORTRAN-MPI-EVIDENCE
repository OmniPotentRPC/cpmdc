#INFO#
#INFO# Evidence build. GCC, OpenMPI, OpenMP, OpenBLAS, Goedecker FFT.
#INFO# -ffp-contract=off. Evidence only, not for upstream as is.
#INFO#

     IRAT=2
     FC='mpif90'
     CC='gcc'
     LD='mpif90'
     CPP=''
     CPPFLAGS='-D__Linux -D__GNU -D__PARALLEL -D__HAS_FFT_DEFAULT    '
     FFLAGS_GROMOS='-ffixed-form $(FFLAGS)'
     FFLAGS_GROMOS_MODULES=' $(FFLAGS)'
     AR='/usr/bin/ar ruv'
     RANLIB='/usr/bin/ranlib'
     if [ $debug ]; then
       FFLAGS='-g -O0 -fcheck=all -Wuninitialized -Wall -fPIC -ffp-contract=off -ffree-line-length-none'
       CFLAGS='-g -O0 -Wall -fPIC -ffp-contract=off'
     else
       FFLAGS='-O2 -Wall -fPIC -ffp-contract=off -ffree-line-length-none'
       CFLAGS='-O2 -Wall -fPIC -ffp-contract=off -Wno-int-conversion'
     fi
     if [ $omp ]; then
       FFLAGS=${FFLAGS}' -fopenmp'
       OMP3_DISABLED=`{ ${FC} -v; } 2>&1 | ${GREP} version | ${AWK} '{ print ( $3 < "4.7.0" ) ? "true" : "false" }'`
       LIBS='-lopenblas'
     else
       LIBS='-lopenblas'
     fi
     probe="${TMPDIR:-/tmp}/cpmdc-allow-$$"
     if echo "      end" | ${FC} -fallow-argument-mismatch -c -o "${probe}.o" -x f95 - >/dev/null 2>&1; then
       FFLAGS=${FFLAGS}' -fallow-argument-mismatch'
     fi
     rm -f "${probe}.o"
     LFLAGS=' '${LIBS}
     if [ $coverage ]; then
       FFLAGS=${FFLAGS}' --coverage'
       LFLAGS='--coverage '${LFLAGS}
     fi
