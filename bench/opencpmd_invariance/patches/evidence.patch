diff -ruN a/src/evidence_dump.mod.F90 b/src/evidence_dump.mod.F90
--- a/src/evidence_dump.mod.F90	1970-01-01 00:00:00.000000000 +0000
+++ b/src/evidence_dump.mod.F90	2026-10-11 11:17:19.489645948 +0000
@@ -0,0 +1,131 @@
+! Evidence only, not for upstream as is.
+! Writes raw f64 results when CPMDC_EVIDENCE_BIN is set.
+! fion is the nuclear gradient (printed as GRADIENTS (-FORCES)).
+! The file stores the physical force, which is -fion.
+! Stress is paiu, column major.
+
+module evidence_dump
+  use ener, only: ener_com
+  use ions, only: ions0, ions1
+  use kinds, only: real_8
+  use norm, only: cnorm, gemax
+  use parac, only: parai, paral
+  use strs, only: paiu
+  use system, only: ncpw, parm, parap
+  implicit none
+  public :: evidence_write_results
+contains
+
+  subroutine evidence_write_results(fion)
+    real(real_8), intent(in) :: fion(:, :, :)
+    character(len=1024) :: path
+    character(len=16) :: nm
+    character(len=16), parameter :: names(24) = (/ &
+         'etot            ', 'ekin            ', 'epseu           ', &
+         'enl             ', 'eht             ', 'ehep            ', &
+         'ehee            ', 'ehii            ', 'exc             ', &
+         'vxc             ', 'egc             ', 'esr             ', &
+         'eself           ', 'eeig            ', 'eband           ', &
+         'entropy         ', 'eext            ', 'ehsic           ', &
+         'ecnstr          ', 'erestr          ', 'eefield         ', &
+         'ebogo           ', 'amu             ', 'etddft          ' /)
+    real(real_8) :: values(24)
+    integer :: iu, is, ia, k, r, length, stat, nforce
+    integer(4) :: i4
+    logical :: opened
+
+    call get_environment_variable('CPMDC_EVIDENCE_BIN', path, length, stat)
+    if (stat /= 0 .or. length <= 0) return
+    if (.not. paral%io_parent) return
+
+    values(1) = ener_com%etot
+    values(2) = ener_com%ekin
+    values(3) = ener_com%epseu
+    values(4) = ener_com%enl
+    values(5) = ener_com%eht
+    values(6) = ener_com%ehep
+    values(7) = ener_com%ehee
+    values(8) = ener_com%ehii
+    values(9) = ener_com%exc
+    values(10) = ener_com%vxc
+    values(11) = ener_com%egc
+    values(12) = ener_com%esr
+    values(13) = ener_com%eself
+    values(14) = ener_com%eeig
+    values(15) = ener_com%eband
+    values(16) = ener_com%entropy
+    values(17) = ener_com%eext
+    values(18) = ener_com%ehsic
+    values(19) = ener_com%ecnstr
+    values(20) = ener_com%erestr
+    values(21) = ener_com%eefield
+    values(22) = ener_com%ebogo
+    values(23) = ener_com%amu
+    values(24) = ener_com%etddft
+
+    nforce = 0
+    do is = 1, ions1%nsp
+      nforce = nforce + ions0%na(is) * 3
+    end do
+
+    open(newunit=iu, file=trim(path(1:length)), access='stream', &
+         form='unformatted', status='replace', iostat=stat)
+    if (stat /= 0) return
+    opened = .true.
+    i4 = int(z'45564431', 4)
+    write(iu) i4
+    i4 = 1_4
+    write(iu) i4
+    i4 = int(ions1%nat, 4)
+    write(iu) i4
+    i4 = 24_4
+    write(iu) i4
+    do k = 1, 24
+      nm = names(k)
+      write(iu) nm
+      write(iu) values(k)
+    end do
+    i4 = int(nforce, 4)
+    write(iu) i4
+    do is = 1, ions1%nsp
+      do ia = 1, ions0%na(is)
+        do k = 1, 3
+          write(iu) -fion(k, ia, is)
+        end do
+      end do
+    end do
+    i4 = 9_4
+    write(iu) i4
+    do ia = 1, 3
+      do is = 1, 3
+        write(iu) paiu(is, ia)
+      end do
+    end do
+    write(iu) parm%omega
+    write(iu) gemax
+    write(iu) cnorm
+    i4 = int(parai%nproc, 4)
+    write(iu) i4
+    if (allocated(parap%sparm) .and. allocated(parap%nrxpl)) then
+      do r = 0, parai%nproc - 1
+        i4 = int(parap%sparm(3, r), 4)
+        write(iu) i4
+        i4 = int(parap%nrxpl(r, 1), 4)
+        write(iu) i4
+        i4 = int(parap%nrxpl(r, 2), 4)
+        write(iu) i4
+      end do
+    else
+      do r = 0, parai%nproc - 1
+        i4 = int(ncpw%ngw, 4)
+        write(iu) i4
+        i4 = 0_4
+        write(iu) i4
+        write(iu) i4
+      end do
+    end if
+    close(iu)
+    if (.not. opened) return
+  end subroutine evidence_write_results
+
+end module evidence_dump
diff -ruN a/src/evidence_flags.h b/src/evidence_flags.h
--- a/src/evidence_flags.h	1970-01-01 00:00:00.000000000 +0000
+++ b/src/evidence_flags.h	2026-10-11 11:17:19.489645948 +0000
@@ -0,0 +1,6 @@
+#ifndef CPMDC_EVIDENCE_FLAGS_H
+#define CPMDC_EVIDENCE_FLAGS_H
+/* Evidence-only switches. The harness build rewrites this file.
+   Absent macros leave the stock OpenCPMD operation in place.
+   This header is not an upstream interface. */
+#endif
diff -ruN a/src/evidence_reduce.mod.F90 b/src/evidence_reduce.mod.F90
--- a/src/evidence_reduce.mod.F90	1970-01-01 00:00:00.000000000 +0000
+++ b/src/evidence_reduce.mod.F90	2026-10-11 11:17:19.489645948 +0000
@@ -0,0 +1,560 @@
+! Evidence only, not for upstream as is.
+! Rank-ordered gather and an int128 fixed-point MPI reduction for mp_sum.
+! The fixed point is x * 2^90. Values with magnitude in [2^-38, 2^37)
+! convert exactly. Subnormals, NaNs and infinities become zero.
+
+#include "evidence_flags.h"
+
+module evidence_reduce
+#ifdef __PARALLEL
+  use mpi
+#endif
+  implicit none
+  public :: evidence_allreduce_r8
+  public :: evidence_allreduce_r8_s
+  public :: evidence_allreduce_r8_inplace
+  public :: evidence_allreduce_c8
+  public :: evidence_allreduce_c8_s
+  public :: evidence_allreduce_c8_inplace
+  public :: evidence_reduce_r8
+  public :: evidence_reduce_r8_s
+  public :: evidence_reduce_c8
+  public :: evidence_reduce_c8_s
+  public :: evidence_gorder_sum
+  public :: evidence_pack_f64
+  public :: evidence_unpack_i128
+  integer, parameter :: evidence_i16 = selected_int_kind(38)
+  integer, parameter :: evidence_scale_bias = 985
+  integer, parameter :: evidence_tag = 44021
+contains
+
+  function evidence_pack_f64(x) result(q)
+    real(8), intent(in) :: x
+    integer(evidence_i16) :: q
+    integer(8) :: bits, frac
+    integer :: expb, sh, sgn
+    bits = transfer(x, 0_8)
+    sgn = int(shiftr(bits, 63))
+    expb = int(ibits(bits, 52, 11))
+    frac = ibits(bits, 0, 52)
+    q = 0_evidence_i16
+    if (expb == 0 .or. expb == 2047) return
+    frac = ior(frac, shiftl(1_8, 52))
+    sh = expb - evidence_scale_bias
+    if (sh >= 0) then
+      if (sh > 74) return
+      q = shiftl(int(frac, evidence_i16), sh)
+    else if (sh > -53) then
+      q = shiftr(int(frac, evidence_i16), -sh)
+    else
+      return
+    end if
+    if (sgn == 1) q = -q
+  end function evidence_pack_f64
+
+  function evidence_unpack_i128(q) result(x)
+    integer(evidence_i16), intent(in) :: q
+    real(8) :: x
+    integer(evidence_i16) :: aq, mant
+    integer(8) :: bits, frac
+    integer :: p, sh, expb, rb, sticky, sgn
+    if (q == 0_evidence_i16) then
+      x = 0.0d0
+      return
+    end if
+    sgn = 0
+    aq = q
+    if (q < 0_evidence_i16) then
+      sgn = 1
+      aq = -q
+    end if
+    p = 127 - leadz(aq)
+    sh = p - 52
+    if (sh >= 0) then
+      mant = shiftr(aq, sh)
+    else
+      mant = shiftl(aq, -sh)
+    end if
+    rb = 0
+    sticky = 0
+    if (sh > 0) then
+      rb = int(ibits(aq, sh - 1, 1))
+      if (sh > 1) then
+        if (iand(aq, shiftl(1_evidence_i16, sh - 1) - 1_evidence_i16) /= 0_evidence_i16) sticky = 1
+      end if
+    end if
+    if (rb == 1) then
+      if (sticky == 1 .or. iand(mant, 1_evidence_i16) == 1_evidence_i16) mant = mant + 1_evidence_i16
+    end if
+    if (mant >= shiftl(1_evidence_i16, 53)) then
+      mant = shiftr(mant, 1)
+      p = p + 1
+    end if
+    frac = int(iand(mant, shiftl(1_evidence_i16, 52) - 1_evidence_i16), 8)
+    expb = p - 90 + 1023
+    if (expb <= 0) then
+      x = 0.0d0
+      return
+    else if (expb >= 2047) then
+      bits = ior(shiftl(int(sgn, 8), 63), shiftl(2047_8, 52))
+      x = transfer(bits, x)
+      return
+    end if
+    bits = ior(shiftl(int(sgn, 8), 63), ior(shiftl(int(expb, 8), 52), frac))
+    x = transfer(bits, x)
+  end function evidence_unpack_i128
+
+#ifdef __PARALLEL
+  subroutine evidence_ensure_exact(dtype, op, ierr)
+    integer, intent(out) :: dtype, op, ierr
+    integer, save :: saved_dtype = -1, saved_op = -1
+    logical, save :: ready = .false.
+    external evidence_sum_i128
+    if (.not. ready) then
+      call mpi_type_contiguous(2, MPI_INTEGER8, saved_dtype, ierr)
+      if (ierr /= 0) return
+      call mpi_type_commit(saved_dtype, ierr)
+      if (ierr /= 0) return
+      call mpi_op_create(evidence_sum_i128, .true., saved_op, ierr)
+      if (ierr /= 0) return
+      ready = .true.
+    end if
+    dtype = saved_dtype
+    op = saved_op
+    ierr = 0
+  end subroutine evidence_ensure_exact
+
+  subroutine evidence_exact_allreduce_r8(sendbuf, recvbuf, n, comm, ierr)
+    real(8), intent(in) :: sendbuf(*)
+    real(8), intent(inout) :: recvbuf(*)
+    integer, intent(in) :: n, comm
+    integer, intent(out) :: ierr
+    integer(evidence_i16), allocatable :: qs(:), qr(:)
+    integer :: dtype, op, i
+    if (n <= 0) then
+      ierr = 0
+      return
+    end if
+    call evidence_ensure_exact(dtype, op, ierr)
+    if (ierr /= 0) return
+    allocate(qs(n), qr(n))
+    do i = 1, n
+      qs(i) = evidence_pack_f64(sendbuf(i))
+    end do
+    call mpi_allreduce(qs, qr, n, dtype, op, comm, ierr)
+    if (ierr /= 0) return
+    do i = 1, n
+      recvbuf(i) = evidence_unpack_i128(qr(i))
+    end do
+  end subroutine evidence_exact_allreduce_r8
+
+  subroutine evidence_gather_allreduce_r8(sendbuf, recvbuf, n, comm, ierr)
+    real(8), intent(in) :: sendbuf(*)
+    real(8), intent(inout) :: recvbuf(*)
+    integer, intent(in) :: n, comm
+    integer, intent(out) :: ierr
+    real(8), allocatable :: tmp(:)
+    integer :: me, np, r, i
+    integer :: stat(MPI_STATUS_SIZE)
+    call mpi_comm_rank(comm, me, ierr)
+    if (ierr /= 0) return
+    call mpi_comm_size(comm, np, ierr)
+    if (ierr /= 0) return
+    if (n <= 0) return
+    allocate(tmp(n))
+    if (me == 0) then
+      do i = 1, n
+        recvbuf(i) = sendbuf(i)
+      end do
+      do r = 1, np - 1
+        call mpi_recv(tmp, n, MPI_DOUBLE_PRECISION, r, evidence_tag, comm, stat, ierr)
+        if (ierr /= 0) return
+        do i = 1, n
+          recvbuf(i) = recvbuf(i) + tmp(i)
+        end do
+      end do
+    else
+      call mpi_send(sendbuf, n, MPI_DOUBLE_PRECISION, 0, evidence_tag, comm, ierr)
+      if (ierr /= 0) return
+    end if
+    call mpi_bcast(recvbuf, n, MPI_DOUBLE_PRECISION, 0, comm, ierr)
+  end subroutine evidence_gather_allreduce_r8
+
+  subroutine evidence_gather_reduce_r8(sendbuf, recvbuf, n, root, comm, ierr)
+    real(8), intent(in) :: sendbuf(*)
+    real(8), intent(inout) :: recvbuf(*)
+    integer, intent(in) :: n, root, comm
+    integer, intent(out) :: ierr
+    real(8), allocatable :: tmp(:)
+    integer :: me, np, r, i
+    integer :: stat(MPI_STATUS_SIZE)
+    call mpi_comm_rank(comm, me, ierr)
+    if (ierr /= 0) return
+    call mpi_comm_size(comm, np, ierr)
+    if (ierr /= 0) return
+    if (n <= 0) return
+    allocate(tmp(n))
+    if (me == root) then
+      do i = 1, n
+        recvbuf(i) = sendbuf(i)
+      end do
+      do r = 0, np - 1
+        if (r == root) cycle
+        call mpi_recv(tmp, n, MPI_DOUBLE_PRECISION, r, evidence_tag, comm, stat, ierr)
+        if (ierr /= 0) return
+        do i = 1, n
+          recvbuf(i) = recvbuf(i) + tmp(i)
+        end do
+      end do
+    else
+      call mpi_send(sendbuf, n, MPI_DOUBLE_PRECISION, root, evidence_tag, comm, ierr)
+    end if
+  end subroutine evidence_gather_reduce_r8
+#endif
+
+  subroutine evidence_allreduce_r8(sendbuf, recvbuf, n, comm, ierr)
+    real(8), intent(in) :: sendbuf(*)
+    real(8), intent(inout) :: recvbuf(*)
+    integer, intent(in) :: n, comm
+    integer, intent(out) :: ierr
+    integer :: i
+#ifdef __PARALLEL
+#if defined(CPMDC_EVIDENCE_MP_EXACT)
+    call evidence_exact_allreduce_r8(sendbuf, recvbuf, n, comm, ierr)
+#elif defined(CPMDC_EVIDENCE_MP_GATHER)
+    call evidence_gather_allreduce_r8(sendbuf, recvbuf, n, comm, ierr)
+#else
+    call mpi_allreduce(sendbuf, recvbuf, n, MPI_DOUBLE_PRECISION, MPI_SUM, comm, ierr)
+#endif
+#else
+    ierr = 0
+    do i = 1, n
+      recvbuf(i) = sendbuf(i)
+    end do
+#endif
+  end subroutine evidence_allreduce_r8
+
+  subroutine evidence_allreduce_r8_s(sendbuf, recvbuf, comm, ierr)
+    real(8), intent(in) :: sendbuf
+    real(8), intent(inout) :: recvbuf
+    integer, intent(in) :: comm
+    integer, intent(out) :: ierr
+    real(8) :: send1(1), recv1(1)
+    send1(1) = sendbuf
+    call evidence_allreduce_r8(send1, recv1, 1, comm, ierr)
+    recvbuf = recv1(1)
+  end subroutine evidence_allreduce_r8_s
+
+  subroutine evidence_allreduce_r8_inplace(buf, n, comm, ierr)
+    real(8), intent(inout) :: buf(*)
+    integer, intent(in) :: n, comm
+    integer, intent(out) :: ierr
+#ifdef __PARALLEL
+#if defined(CPMDC_EVIDENCE_MP_EXACT)
+    call evidence_exact_allreduce_r8(buf, buf, n, comm, ierr)
+#elif defined(CPMDC_EVIDENCE_MP_GATHER)
+    block
+      real(8), allocatable :: local(:)
+      integer :: i
+      allocate(local(max(n, 1)))
+      do i = 1, n
+        local(i) = buf(i)
+      end do
+      call evidence_gather_allreduce_r8(local, buf, n, comm, ierr)
+    end block
+#else
+    call mpi_allreduce(MPI_IN_PLACE, buf, n, MPI_DOUBLE_PRECISION, MPI_SUM, comm, ierr)
+#endif
+#else
+    ierr = 0
+#endif
+  end subroutine evidence_allreduce_r8_inplace
+
+  subroutine evidence_copy_c8_to_r8(z, r, n)
+    complex(8), intent(in) :: z(*)
+    real(8), intent(out) :: r(*)
+    integer, intent(in) :: n
+    integer :: i
+    do i = 1, n
+      r(2 * i - 1) = real(z(i), 8)
+      r(2 * i) = aimag(z(i))
+    end do
+  end subroutine evidence_copy_c8_to_r8
+
+  subroutine evidence_copy_r8_to_c8(r, z, n)
+    real(8), intent(in) :: r(*)
+    complex(8), intent(out) :: z(*)
+    integer, intent(in) :: n
+    integer :: i
+    do i = 1, n
+      z(i) = cmplx(r(2 * i - 1), r(2 * i), 8)
+    end do
+  end subroutine evidence_copy_r8_to_c8
+
+  subroutine evidence_allreduce_c8(sendbuf, recvbuf, n, comm, ierr)
+    complex(8), intent(in) :: sendbuf(*)
+    complex(8), intent(inout) :: recvbuf(*)
+    integer, intent(in) :: n, comm
+    integer, intent(out) :: ierr
+    integer :: i
+#ifdef __PARALLEL
+#if defined(CPMDC_EVIDENCE_MP_EXACT) || defined(CPMDC_EVIDENCE_MP_GATHER)
+    block
+      real(8), allocatable :: sr(:), rr(:)
+      allocate(sr(max(2 * n, 1)), rr(max(2 * n, 1)))
+      call evidence_copy_c8_to_r8(sendbuf, sr, n)
+      call evidence_allreduce_r8(sr, rr, 2 * n, comm, ierr)
+      if (ierr == 0) call evidence_copy_r8_to_c8(rr, recvbuf, n)
+    end block
+#else
+    call mpi_allreduce(sendbuf, recvbuf, n, MPI_DOUBLE_COMPLEX, MPI_SUM, comm, ierr)
+#endif
+#else
+    ierr = 0
+    do i = 1, n
+      recvbuf(i) = sendbuf(i)
+    end do
+#endif
+  end subroutine evidence_allreduce_c8
+
+  subroutine evidence_allreduce_c8_s(sendbuf, recvbuf, comm, ierr)
+    complex(8), intent(in) :: sendbuf
+    complex(8), intent(inout) :: recvbuf
+    integer, intent(in) :: comm
+    integer, intent(out) :: ierr
+    complex(8) :: send1(1), recv1(1)
+    send1(1) = sendbuf
